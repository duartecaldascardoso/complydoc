<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>complydoc — {{ report.run.target }}</title>
<style>
  html { -webkit-text-size-adjust: 100%; }
  :root {
    --accent: #1a7f4b; --paper: #fbfbfa; --line: #e8e8e6;
    --good: #1a7f4b; --good-bg: #e8f3ec;
    --fair: #8a5a00; --fair-bg: #fbf1de;
    --poor: #b3261e; --poor-bg: #fbeae8;
    --na:   #6b7280; --na-bg:   #f0f1f3;
  }
  body {
    margin: 0 auto; padding: 2.5rem 1.5rem 6rem; max-width: 60rem;
    background: var(--paper); color: #111;
    font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    font-variant-numeric: tabular-nums;
  }
  .logo { display: block; margin: 0 0 1.25rem -4px; }
  .head { border-bottom: 2px solid var(--accent); padding-bottom: 0.875rem; margin-bottom: 0.5rem; }
  h1 { font-size: 1.375rem; font-weight: 600; margin: 0 0 0.25rem; }
  h2 { font-size: 1rem; font-weight: 600; margin: 2.75rem 0 0.75rem;
       padding-top: 0.75rem; border-top: 1px solid #111; }
  h3 { font-size: 0.9375rem; font-weight: 600; margin: 1.75rem 0 0.5rem; }
  h4 { font-size: 0.8125rem; font-weight: 600; margin: 1.5rem 0 0.375rem; color: #444; }
  p  { margin: 0 0 0.75rem; }
  .meta { color: #666; font-size: 0.8125rem; margin: 0; }
  .note { color: #555; font-size: 0.8125rem; max-width: 46rem; }
  code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 0.875em; }

  table { border-collapse: collapse; width: 100%; margin: 0.5rem 0 1rem; font-size: 0.875rem; }
  th, td { text-align: left; padding: 0.375rem 0.75rem 0.375rem 0; vertical-align: top;
           border-bottom: 1px solid var(--line); }
  th { font-weight: 600; border-bottom: 1px solid #111; white-space: nowrap; }
  td.n, th.n { text-align: right; white-space: nowrap; padding-right: 1.25rem; }
  .scroll { overflow-x: auto; }
  /* Ratings and severities are the two things a reader scans for, so they get
     the colour. Everything else stays monochrome. */
  .r { display: inline-block; padding: 0.0625rem 0.375rem; border-radius: 2px;
       font-size: 0.75rem; font-weight: 600; white-space: nowrap; }
  .r-good { background: var(--good-bg); color: var(--good); }
  .r-fair { background: var(--fair-bg); color: var(--fair); }
  .r-poor { background: var(--poor-bg); color: var(--poor); }
  .r-na   { background: var(--na-bg);   color: var(--na); font-weight: 400; }
  .poor { color: var(--poor); font-weight: 600; }
  .fair { color: var(--fair); }
  td.n .poor { font-weight: 600; }
  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; white-space: nowrap; }
  .why { color: #666; font-size: 0.8125rem; }

  .box { border: 1px solid #111; border-left: 3px solid var(--accent);
         background: #fff; padding: 0.75rem 1rem; margin: 1rem 0; font-size: 0.875rem; }
  .box p:last-child { margin-bottom: 0; }
  .box strong { display: block; }

  details { margin: 0; border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; padding: 0.625rem 0; font-weight: 600; font-size: 0.9375rem; }
  summary span { font-weight: 400; color: #666; font-size: 0.8125rem; }
  details > div { padding: 0 0 1.5rem; }

  ul { margin: 0.25rem 0 0.75rem; padding-left: 1.125rem; }
  li { margin-bottom: 0.25rem; }
  .lim { margin: 0 0 1.125rem; max-width: 46rem; padding-left: 0.75rem;
         border-left: 3px solid var(--line); }
  .lim.important { border-left-color: var(--fair); }
  .lim .h { font-weight: 600; font-size: 0.8125rem; }
  .ok { color: var(--accent); }
  .lim .files { color: #666; font-size: 0.75rem; margin-top: 0.25rem;
                font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
                word-break: break-all; }
  .pages { display: flex; flex-wrap: wrap; gap: 1.5rem; margin: 0.75rem 0 1rem; }
  .page { }
  .pair { display: flex; gap: 0.5rem; }
  .half { }
  .half > .lbl { font-size: 0.625rem; color: #999; text-transform: uppercase;
                 letter-spacing: 0.06em; margin-bottom: 0.1875rem; }
  .pv, .pg { display: block; width: 240px; height: auto; background: #fff;
             border: 1px solid #ccc; }
  .page .cap { font-size: 0.6875rem; color: #666; margin-top: 0.375rem; line-height: 1.3; }
  .key { display: flex; flex-wrap: wrap; gap: 1rem; font-size: 0.75rem; color: #666;
         margin: 0 0 1rem; align-items: center; }
  .key span { display: inline-flex; align-items: center; gap: 0.3125rem; }
  .sw { width: 11px; height: 11px; display: inline-block; border: 1px solid #bbb; }
  .filter { display: flex; gap: 0.5rem; align-items: baseline; margin: 0 0 0.75rem; }
  .filter input { font: inherit; font-size: 0.875rem; padding: 0.3125rem 0.5rem;
                  border: 1px solid #ccc; background: #fff; color: inherit;
                  border-radius: 0; min-width: 18rem; }
  .filter input:focus { outline: 2px solid var(--accent); outline-offset: -1px; }
  .filter .count { font-size: 0.8125rem; color: #666; }
  .pager { display: flex; gap: 0.5rem; align-items: baseline; margin: -0.5rem 0 1rem;
           font-size: 0.8125rem; color: #666; }
  .pager button { font: inherit; padding: 0.125rem 0.5rem; border: 1px solid #ccc;
                  background: #fff; color: inherit; cursor: pointer; }
  .pager button:disabled { color: #bbb; cursor: default; }
  @media print { .filter, .pager { display: none; } }
  .drivers { display: flex; flex-wrap: wrap; gap: 2rem; margin: 0.25rem 0 1.25rem; }
  .driver { flex: 1 1 22rem; min-width: 0; }
  .driver > .lbl { font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.06em;
                   color: #888; margin-bottom: 0.375rem;
                   border-bottom: 1px solid var(--line); padding-bottom: 0.25rem; }
  table.bare { margin: 0; table-layout: fixed; }
  table.bare td { border-bottom: none; padding: 0.25rem 0.5rem 0 0; }
  table.bare tr.d-head td { font-weight: 600; font-size: 0.8125rem; padding-top: 0.5rem; }
  table.bare tr.d-why td { padding: 0 0 0.5rem; border-bottom: 1px solid #f0f0ee; }
  table.bare td.v { white-space: normal; font-weight: 400; color: #444;
                    font-size: 0.8125rem; text-align: right; width: 42%; }
  table.bare td.n { width: 3rem; }
  .wt { font-size: 0.6875rem; color: #999; }
  .warn { border: 1px solid var(--fair); border-left-width: 3px; background: var(--fair-bg);
          padding: 0.625rem 0.875rem; margin: 0.75rem 0; font-size: 0.8125rem; }
  .warn ul { margin: 0.25rem 0 0; }
  details.more { border: none; margin: 0.5rem 0 0; }
  details.more > summary { font-weight: 400; font-size: 0.8125rem; color: #666;
                           padding: 0.375rem 0; }
  details.more > summary::marker { color: #bbb; }
  footer { margin-top: 3rem; padding-top: 0.75rem; border-top: 1px solid var(--line);
           color: #888; font-size: 0.75rem; }
  @media print {
    body { padding: 0; max-width: none; font-size: 10.5pt; background: #fff; }
    details > div { display: block !important; }
    summary { list-style: none; }
    h2 { break-after: avoid; }
    tr, .lim { break-inside: avoid; }
  }
</style>
</head>
<body>

{{ logo_svg | safe }}
<div class="head">
  <h1>Document audit</h1>
  <p class="meta">{{ report.run.target }}</p>
  <p class="meta">{{ report.run.finished_at }} · complydoc {{ report.run.tool_version }} · {{ report.run.components_run | join(", ") }}</p>
</div>

{% if report.run.reveal_used %}
<div class="box">
  <strong>This report contains unmasked sensitive values.</strong>
  <p>Generated with <code>--reveal</code>. Handle it with the same care as the documents it
  describes.</p>
</div>
{% endif %}

{% if report.run.page_images_used %}
<div class="box">
  <strong>This report contains pictures of the documents.</strong>
  <p>Generated with <code>--page-images</code>, so it carries the page content itself,
  not just measurements of it. Masking still applies to the values in the tables, but the
  pages beside them are readable.</p>
</div>
{% endif %}

{% if report.staleness_warnings %}
<div class="box">
  <strong>Unverified prices</strong>
  <ul>{% for w in report.staleness_warnings %}<li>{{ w }}</li>{% endfor %}</ul>
</div>
{% endif %}

{# ---------------------------------------------------------------- SUMMARY #}
<h2>Summary</h2>
{% set agg = report.aggregate %}
<table>
  <tbody>
    <tr><td>Documents audited</td><td class="n">{{ agg.documents_audited }}</td>
        <td class="why">{{ agg.pages_total }} page(s){% if agg.documents_skipped %}, {{ agg.documents_skipped }} file(s) skipped{% endif %}</td></tr>
    {% if agg.total_text_path_usd is not none %}
    <tr><td>Text path, this folder</td><td class="n">{{ money(agg.total_text_path_usd) }}</td>
        <td class="why">input tokens only</td></tr>
    {% endif %}
    {% if agg.total_vision_path_usd is not none %}
    <tr><td>Vision path, this folder</td><td class="n">{{ money(agg.total_vision_path_usd) }}</td>
        <td class="why">at {{ report.cost.headline_resolution }} resolution</td></tr>
    {% endif %}
    {% if agg.mean_difficulty_score is not none %}
    <tr><td>Mean difficulty score</td><td class="n">{{ agg.mean_difficulty_score }} / 100</td>
        <td class="why">higher is easier</td></tr>
    {% endif %}
    {% if "sensitive" in report.run.components_run %}
    <tr><td>Sensitive items found</td><td class="n">{{ agg.sensitive_total }}</td>
        <td class="why">in {{ agg.documents_with_sensitive_data }} of {{ agg.documents_audited }} document(s)</td></tr>
    {% endif %}
    {% if agg.pages_unreadable %}
    <tr><td>Pages not read</td><td class="n">{{ agg.pages_unreadable }}</td>
        <td class="why">not searched for sensitive data</td></tr>
    {% endif %}
    <tr><td>Network guard</td><td class="n">{% if report.run.offline_guard == "armed" %}<span class="ok">armed</span>{% else %}<span class="poor">{{ report.run.offline_guard }}</span>{% endif %}</td>
        <td class="why">no document content left this machine</td></tr>
  </tbody>
</table>

{% if agg.annual_text_usd is not none or agg.annual_vision_usd is not none %}
<h3>At {{ "{:,}".format(report.run.monthly_volume) }} documents a month</h3>
<div class="scroll"><table>
  <thead><tr><th>Path</th><th class="n">Per document</th><th class="n">Monthly</th><th class="n">Annual</th></tr></thead>
  <tbody>
    {% if agg.monthly_text_usd is not none %}
    <tr><td>Text extraction</td>
        <td class="n">{{ money(report.cost.volume.mean_text_path_usd) }}</td>
        <td class="n">{{ money(agg.monthly_text_usd) }}</td>
        <td class="n">{{ money(agg.annual_text_usd) }}</td></tr>
    {% endif %}
    {% if agg.monthly_vision_usd is not none %}
    <tr><td>Vision, {{ report.cost.headline_resolution }} resolution</td>
        <td class="n">{{ money(report.cost.volume.mean_vision_path_usd) }}</td>
        <td class="n">{{ money(agg.monthly_vision_usd) }}</td>
        <td class="n">{{ money(agg.annual_vision_usd) }}</td></tr>
    {% endif %}
  </tbody>
</table></div>
<p class="note">{{ report.cost.volume.basis }}</p>
{% endif %}

{% if agg.sensitive_by_category %}
<h3>Sensitive information</h3>
<div class="scroll"><table>
  <thead><tr><th>Category</th><th>Severity</th><th class="n">Count</th><th>Note</th></tr></thead>
  <tbody>
  {% for cat, count in agg.sensitive_by_category | dictsort(by='value', reverse=true) %}
    {% set m = category_meta(cat) %}
    <tr><td>{{ m.label }}</td>
        <td>{{ severity_badge(m.severity) | safe }}</td>
        <td class="n">{{ count }}</td>
        <td class="why">{{ m.note }}</td></tr>
  {% endfor %}
  </tbody>
</table></div>
<p class="note">Values are masked. At most the last
{{ report.config_masking.reveal_tail_chars }} characters of any identifier appear in this
report{% if report.config_masking.never_reveal %}; {{ report.config_masking.never_reveal | join(" and ") }}
are never shown in full, even with <code>--reveal</code>{% endif %}.</p>
{% elif "sensitive" in report.run.components_run %}
<p class="note">Nothing detected in the text that could be read. Check the limitations below
before reading that as an all-clear.</p>
{% endif %}

{% if agg.signal_distribution %}
<h3>Difficulty signals across the folder</h3>
<div class="scroll"><table>
  <thead><tr><th>Signal</th>{% if report.signal_weights %}<th class="n">Weight</th>{% endif %}
    <th class="n">Good</th><th class="n">Fair</th><th class="n">Poor</th><th class="n">N/A</th></tr></thead>
  <tbody>
  {% for sid, d in agg.signal_distribution | dictsort %}
    <tr><td>{{ signal_name(sid) }}</td>
      {% if report.signal_weights %}<td class="n">{{ "%.2f"|format(report.signal_weights.get(sid, 0)) }}</td>{% endif %}
      <td class="n">{% if d.good %}<span style="color:var(--good)">{{ d.good }}</span>{% endif %}</td>
      <td class="n">{% if d.fair %}<span style="color:var(--fair)">{{ d.fair }}</span>{% endif %}</td>
      <td class="n">{% if d.poor %}<span class="poor">{{ d.poor }}</span>{% endif %}</td>
      <td class="n">{% if d.not_applicable %}<span style="color:var(--na)">{{ d.not_applicable }}</span>{% endif %}</td></tr>
  {% endfor %}
  </tbody>
</table></div>
{% if report.signal_weights %}
<p class="note">Weights come from <code>difficulty.yaml</code>. A score is only produced when
every weight behind it is shown.</p>
{% endif %}
{% endif %}

{# -------------------------------------------------------------- DOCUMENTS #}
<h2>Documents</h2>
<div id="docs">
{% for doc in report.documents %}
<details{% if report.documents | length <= 3 %} open{% endif %}>
  <summary>{{ doc.relative_path }}
    <span>— {{ doc.format }}, {{ doc.page_count }} page(s){% if not doc.page_count_known %} (not fixed){% endif %}{% if doc.difficulty and doc.difficulty.score %}, difficulty <span class="r r-{{ score_band(doc.difficulty.score.value) }}">{{ doc.difficulty.score.value }}/100</span>{% endif %}{% if doc.sensitive and doc.sensitive.total %}, {{ doc.sensitive.total }} sensitive item(s){% endif %}</span>
  </summary>
  <div>

  {% if doc.load_warnings %}
    <div class="warn">
      <strong>Reading this document was incomplete.</strong>
      <ul>{% for w in doc.load_warnings %}<li>{{ w }}</li>{% endfor %}</ul>
    </div>
  {% endif %}

  {% if doc.previews %}
    <div class="pages">
    {% for pv in doc.previews[:max_preview_pages] %}
      <div class="page">
        <div class="pair">
          {% if pv.image_data_uri %}
          <div class="half">
            <div class="lbl">document</div>
            <img class="pg" src="{{ pv.image_data_uri }}" alt="Page {{ pv.number }}" loading="lazy">
          </div>
          {% endif %}
          <div class="half">
            <div class="lbl">{{ "extracted" if pv.image_data_uri else "layout" }}</div>
            {{ page_preview_svg(pv) | safe }}
          </div>
        </div>
        <div class="cap">p{{ pv.number }}{% if pv.rotation %} · {{ pv.rotation }}°{% endif %} ·
          {{ pv.image_coverage_pct | round | int }}% img{% if pv.sensitive_count %} ·
          {{ pv.sensitive_count }} sensitive{% endif %}</div>
      </div>
    {% endfor %}
    </div>
    {% if doc.previews | length > max_preview_pages %}
      <p class="note">Showing the first {{ max_preview_pages }} of {{ doc.previews | length }} pages.</p>
    {% endif %}
  {% endif %}

  {# ---------------------------------------------------- 1. HOW HARD, AND WHY #}
  {% if doc.difficulty %}
    {% set hard = hard_drivers(doc.difficulty) %}
    {% set easy = easy_drivers(doc.difficulty) %}
    <h4>How hard it is to extract{% if doc.difficulty.score %} —
      <span class="r r-{{ score_band(doc.difficulty.score.value) }}">{{ doc.difficulty.score.label }},
      {{ doc.difficulty.score.value }}/100</span>{% endif %}</h4>
    <div class="drivers">
      <div class="driver">
        <div class="lbl">makes it harder</div>
        {% if hard %}
        <table class="bare"><tbody>
        {% for s in hard %}
          <tr class="d-head"><td>{{ s.name }}</td>
              <td class="v">{{ s.display }}</td>
              <td class="n"><span class="wt">{{ "%.2f"|format(s.weight) }}</span></td></tr>
          <tr class="d-why"><td colspan="3" class="why">{{ s.why }}</td></tr>
        {% endfor %}
        </tbody></table>
        {% else %}<p class="note">Nothing rated poor.</p>{% endif %}
      </div>
      <div class="driver">
        <div class="lbl">makes it easier</div>
        {% if easy %}
        <table class="bare"><tbody>
        {% for s in easy %}
          <tr class="d-head"><td>{{ s.name }}</td>
              <td class="v">{{ s.display }}</td>
              <td class="n"><span class="wt">{{ "%.2f"|format(s.weight) }}</span></td></tr>
          <tr class="d-why"><td colspan="3" class="why">{{ s.why }}</td></tr>
        {% endfor %}
        </tbody></table>
        {% else %}<p class="note">Nothing rated good.</p>{% endif %}
      </div>
    </div>
    {% if doc.difficulty.score and doc.difficulty.score.confidence_note %}
      <p class="note">{{ doc.difficulty.score.confidence_note }}</p>
    {% endif %}
  {% endif %}

  {# ------------------------------------------------------------- 2. COST #}
  {% if doc.cost %}
    <h4>Estimated input cost</h4>
    <div class="scroll"><table>
      <thead><tr><th>Model</th><th class="n">Text tokens</th><th class="n">Text path</th>
        <th class="n">Vision tokens</th><th class="n">Vision path</th><th>Price verified</th></tr></thead>
      <tbody>
      {% for m in doc.cost.models %}
        {% set res = report.cost.headline_resolution %}
        <tr>
          <td>{{ m.display_name }}<div class="why">{{ m.provider }}, {{ m.text_token_fidelity }} token count</div></td>
          <td class="n">{{ "{:,}".format(m.text_tokens) }}</td>
          <td class="n">{% if m.text_path_input_usd is not none %}{{ money(m.text_path_input_usd) }}{% else %}n/a{% endif %}</td>
          <td class="n">{% if m.vision_tokens_by_resolution.get(res) is not none %}{{ "{:,}".format(m.vision_tokens_by_resolution[res]) }}{% else %}—{% endif %}</td>
          <td class="n">{% if m.vision_input_usd_by_resolution.get(res) is not none %}{{ money(m.vision_input_usd_by_resolution[res]) }}{% else %}n/a{% endif %}</td>
          <td>{% if m.last_verified %}{% if m.is_stale %}<span class="r r-poor">{{ m.last_verified }}</span>{% else %}<span class="r r-good">{{ m.last_verified }}</span>{% endif %}{% else %}<span class="r r-poor">never</span>{% endif %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table></div>
    {% set unavailable = doc.cost.models | selectattr("text_path_unavailable_reason") | list %}
    {% if unavailable %}
      <p class="note">Text path not applicable: {{ unavailable[0].text_path_unavailable_reason }}</p>
    {% endif %}
    {% set novision = doc.cost.models | selectattr("vision_path_unavailable_reason") | list %}
    {% if novision %}
      <p class="note">Vision path not applicable: {{ novision[0].vision_path_unavailable_reason }}</p>
    {% endif %}
  {% endif %}

  {# -------------------------------------------------------- 3. SENSITIVE #}
  {% if doc.sensitive %}
    <h4>Sensitive information{% if doc.sensitive.total %} — {{ doc.sensitive.total }} item(s){% endif %}</h4>
    {% if doc.sensitive.matches %}
    <div class="scroll"><table data-paginate="12">
      <thead><tr><th class="n">Page</th><th class="n">Line</th><th class="n">Col</th>
        <th>Category</th><th>Severity</th><th>Value</th>{% if report.run.reveal_used %}<th>Revealed</th>{% endif %}<th>Matched because</th></tr></thead>
      <tbody>
      {% for m in doc.sensitive.matches %}
        <tr><td class="n">{{ m.page }}</td><td class="n">{{ m.line }}</td><td class="n">{{ m.column }}</td>
          <td>{{ m.label }}</td>
          <td>{{ severity_badge(m.severity) | safe }}</td>
          <td class="mono">{{ m.masked }}</td>
          {% if report.run.reveal_used %}<td class="mono">{{ m.revealed if m.revealed else "—" }}</td>{% endif %}
          <td class="why">
            {%- if m.validators_passed %}passed {{ m.validators_passed | join(", ") }}{% endif -%}
            {%- if m.context_term %}{% if m.validators_passed %}; {% endif %}near "{{ m.context_term }}"{% endif -%}
            {%- if not m.validators_passed and not m.context_term %}pattern match{% endif -%}
          </td></tr>
      {% endfor %}
      </tbody>
    </table></div>
    {% else %}
      <p class="note">Nothing detected in the text that could be read.</p>
    {% endif %}
    {% if doc.sensitive.unreadable_pages %}
      <p class="note"><strong>Page(s) {{ doc.sensitive.unreadable_pages | join(", ") }} carried no
      readable text and were not searched.</strong> Zero findings there means those pages were not
      looked at, not that they are clean.</p>
    {% endif %}
  {% endif %}

  {# --------------------------------------------------- everything else #}
  <details class="more">
    <summary>All signals, page detail and provenance</summary>
    <div>
    {% if doc.difficulty %}
      <div class="scroll"><table>
        <thead><tr><th>Signal</th><th>Measured</th><th>Rating</th>
          {% if report.signal_weights %}<th class="n">Weight</th>{% endif %}<th>Why it matters</th></tr></thead>
        <tbody>
        {% for s in doc.difficulty.signals %}
          <tr>
            <td>{{ s.name }}</td>
            <td>{{ s.display }}{% if s.reason %}<div class="why">{{ s.reason }}</div>{% endif %}</td>
            <td>{% if s.rating %}<span class="r r-{{ s.rating }}">{{ s.rating }}</span>{% else %}<span class="r r-na">{{ s.status.replace("_", " ") }}</span>{% endif %}</td>
            {% if report.signal_weights %}<td class="n">{{ "%.2f"|format(s.weight) }}</td>{% endif %}
            <td class="why">{{ s.why }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table></div>
      {% if doc.difficulty.score %}
        <p class="note">{{ doc.difficulty.score.method }}</p>
      {% endif %}
    {% endif %}

    {% if doc.cost %}
      <div class="scroll"><table data-paginate="15">
        <thead><tr><th class="n">Page</th><th>Size</th><th class="n">Scan DPI</th><th>Text</th><th class="n">Text coverage</th></tr></thead>
        <tbody>
        {% for p in doc.cost.pages %}
          <tr><td class="n">{{ p.number }}</td><td>{{ p.size_label }}</td>
            <td class="n">{{ p.dpi if p.dpi else "—" }}</td><td>{{ p.text_source }}</td>
            <td class="n">{{ "%.1f"|format(p.text_coverage_pct) }}%</td></tr>
        {% endfor %}
        </tbody>
      </table></div>
    {% endif %}

    {% set unplaced = doc.previews | sum(attribute='unlocated_sensitive') %}
    {% if unplaced %}
      <p class="note">{{ unplaced }} sensitive match(es) could not be placed on the page. They are
      still counted above.</p>
    {% endif %}
    <p class="note">SHA-256 <code>{{ doc.sha256 }}</code></p>
    </div>
  </details>

  </div>
</details>
{% else %}
<p class="note">No documents were audited.</p>
{% endfor %}
</div>

{% if report.skipped %}
<h3>Files skipped</h3>
<div class="scroll"><table data-paginate="15">
  <thead><tr><th>File</th><th>Reason</th><th>Detail</th></tr></thead>
  <tbody>{% for s in report.skipped %}
    <tr><td class="mono">{{ s.path.name }}</td><td>{{ s.reason }}</td><td class="why">{{ s.detail or "—" }}</td></tr>
  {% endfor %}</tbody>
</table></div>
{% endif %}

{# ------------------------------------------------------------ LIMITATIONS #}
<h2>Limitations of this run</h2>
<p class="note">Generated from what happened during this run, not a standard disclaimer.</p>
{% for lim in report.limitations %}
  <div class="lim{% if lim.severity == 'important' %} important{% endif %}">
    <div class="h">{{ lim.area }}{% if lim.severity == "important" %} — important{% endif %}</div>
    <div class="why">{{ lim.statement }}</div>
    {% if lim.affected %}<div class="files">{{ lim.affected | join(" · ") }}</div>{% endif %}
  </div>
{% else %}
  <p class="note">Nothing was skipped and every configured check ran on every document.</p>
{% endfor %}

<footer>
complydoc {{ report.run.tool_version }} · schema v{{ report.run.schema_version }} ·
config {{ report.run.config_digest }} · Python {{ report.run.python_version }} ·
{{ "%.1f"|format(report.run.duration_seconds) }}s ·
OCR {{ "on" if report.run.ocr_available and report.run.ocr_requested else "off" }} ·
name detection {{ "on" if report.run.ner_available else "off" }}
</footer>

<script>
/* Progressive enhancement only: with scripting off, every document and every
   table row is already on the page. This adds a filter and pagination for runs
   large enough that scrolling stops working. */
(function () {
  "use strict";

  function makeFilter(container) {
    var items = Array.prototype.slice.call(container.children).filter(function (el) {
      return el.tagName === "DETAILS";
    });
    if (items.length < 5) return;

    var bar = document.createElement("div");
    bar.className = "filter";
    var input = document.createElement("input");
    input.type = "search";
    input.placeholder = "Filter documents — filename, category, any text";
    input.setAttribute("aria-label", "Filter documents");
    var count = document.createElement("span");
    count.className = "count";
    bar.appendChild(input);
    bar.appendChild(count);
    container.parentNode.insertBefore(bar, container);

    var haystacks = items.map(function (el) { return el.textContent.toLowerCase(); });

    function apply() {
      var q = input.value.trim().toLowerCase();
      var shown = 0;
      items.forEach(function (el, i) {
        var hit = !q || haystacks[i].indexOf(q) !== -1;
        el.hidden = !hit;
        if (hit) shown++;
      });
      count.textContent = q
        ? shown + " of " + items.length + " document(s)"
        : items.length + " document(s)";
    }
    input.addEventListener("input", apply);
    apply();
  }

  function paginate(table) {
    var size = parseInt(table.getAttribute("data-paginate"), 10);
    var body = table.tBodies[0];
    if (!body || !size) return;
    var rows = Array.prototype.slice.call(body.rows);
    if (rows.length <= size) return;

    var page = 0;
    var pages = Math.ceil(rows.length / size);

    var bar = document.createElement("div");
    bar.className = "pager";
    var prev = document.createElement("button");
    prev.type = "button";
    prev.textContent = "Previous";
    var next = document.createElement("button");
    next.type = "button";
    next.textContent = "Next";
    var label = document.createElement("span");
    bar.appendChild(prev);
    bar.appendChild(next);
    bar.appendChild(label);
    var host = table.parentNode;
    host.parentNode.insertBefore(bar, host.nextSibling);

    function draw() {
      var first = page * size;
      var last = Math.min(first + size, rows.length);
      rows.forEach(function (row, i) { row.hidden = i < first || i >= last; });
      label.textContent = "Showing " + (first + 1) + "\u2013" + last + " of " + rows.length;
      prev.disabled = page === 0;
      next.disabled = page >= pages - 1;
    }
    prev.addEventListener("click", function () { if (page > 0) { page--; draw(); } });
    next.addEventListener("click", function () { if (page < pages - 1) { page++; draw(); } });
    draw();
  }

  var docs = document.getElementById("docs");
  if (docs) makeFilter(docs);
  Array.prototype.forEach.call(
    document.querySelectorAll("table[data-paginate]"), paginate
  );
})();
</script>

</body>
</html>
