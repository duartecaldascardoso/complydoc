<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>complydoc — {{ report.run.target }}</title>
<link rel="icon" href="{{ favicon_uri }}">
<style>
  html { -webkit-text-size-adjust: 100%; }
  :root {
    color-scheme: light;
    --paper: #fbfbfa; --panel: #fff; --ink: #111; --ink-2: #333;
    --muted: #666; --faint: #999; --line: #e8e8e6; --line-2: #d8d8d4;
    --accent: #1a7f4b;
    --good: #1a7f4b; --good-bg: #e8f3ec;
    --fair: #8a5a00; --fair-bg: #fbf1de;
    --poor: #b3261e; --poor-bg: #fbeae8;
    --na:   #6b7280; --na-bg:   #f0f1f3;
    --series-1: #2a78d6; --series-2: #4a3aa7; --series-3: #e87ba4;
    --pv-page: #fff; --pv-edge: #bbb; --pv-text: #dcdcdc;
    --pv-image: #f4dfae; --pv-gutter: #f4f4f2;
  }
  /* Dark is selected, not flipped: the chart steps were validated against the dark
     surface on their own, and the middle series changes hue because violet and blue
     are indistinguishable to a protanope there. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      color-scheme: dark;
      --paper: #16181a; --panel: #1d2023; --ink: #e9e9e7; --ink-2: #c9c9c6;
      --muted: #9aa0a6; --faint: #71767b; --line: #2b2f33; --line-2: #3a3f45;
      --accent: #4cc38a;
      --good: #4cc38a; --good-bg: #12291f;
      --fair: #d9a441; --fair-bg: #2c2415;
      --poor: #f2726a; --poor-bg: #2e1a19;
      --na:   #9aa0a6; --na-bg:   #24282c;
      --series-1: #3987e5; --series-2: #d55181; --series-3: #c98500;
      --pv-page: #24282c; --pv-edge: #4a5058; --pv-text: #4d545c;
      --pv-image: #6d5a2f; --pv-gutter: #1f2225;
    }
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
    --paper: #16181a; --panel: #1d2023; --ink: #e9e9e7; --ink-2: #c9c9c6;
    --muted: #9aa0a6; --faint: #71767b; --line: #2b2f33; --line-2: #3a3f45;
    --accent: #4cc38a;
    --good: #4cc38a; --good-bg: #12291f;
    --fair: #d9a441; --fair-bg: #2c2415;
    --poor: #f2726a; --poor-bg: #2e1a19;
    --na:   #9aa0a6; --na-bg:   #24282c;
    --series-1: #3987e5; --series-2: #d55181; --series-3: #c98500;
    --pv-page: #24282c; --pv-edge: #4a5058; --pv-text: #4d545c;
    --pv-image: #6d5a2f; --pv-gutter: #1f2225;
  }
  body {
    margin: 0 auto; padding: 2.5rem 1.5rem 6rem; max-width: 60rem;
    background: var(--paper); color: var(--ink);
    font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    font-variant-numeric: tabular-nums;
  }
  .logo { display: block; margin: 0 0 1.25rem -4px; }
  .head { border-bottom: 2px solid var(--accent); padding-bottom: 0.875rem; margin-bottom: 0.5rem; }
  h1 { font-size: 1.375rem; font-weight: 600; margin: 0 0 0.25rem; }
  h2 { font-size: 1rem; font-weight: 600; margin: 2.75rem 0 0.75rem;
       padding-top: 0.75rem; border-top: 1px solid var(--line-2); }
  h3 { font-size: 0.9375rem; font-weight: 600; margin: 1.75rem 0 0.5rem; }
  h4 { font-size: 0.8125rem; font-weight: 600; margin: 1.5rem 0 0.375rem; color: var(--ink-2); }
  p  { margin: 0 0 0.75rem; }
  .meta { color: var(--muted); font-size: 0.8125rem; margin: 0; }
  .note { color: var(--muted); font-size: 0.8125rem; max-width: 46rem; }
  code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 0.875em; }

  table { border-collapse: collapse; width: 100%; margin: 0.5rem 0 1rem; font-size: 0.875rem; }
  th, td { text-align: left; padding: 0.375rem 0.75rem 0.375rem 0; vertical-align: top;
           border-bottom: 1px solid var(--line); }
  th { font-weight: 600; border-bottom: 1px solid var(--line-2); white-space: nowrap; }
  td.n, th.n { text-align: right; white-space: nowrap; padding-right: 1.25rem; }
  .scroll { overflow-x: auto; }
  /* Ratings and severities are the two things a reader scans for, so they get
     the colour. Everything else stays monochrome. */
  .r { display: inline-block; padding: 0.0625rem 0.375rem; border-radius: 2px;
       font-size: 0.75rem; font-weight: 600; white-space: nowrap; }
  .r-good { background: var(--good-bg); color: var(--good); }
  .r-fair { background: var(--fair-bg); color: var(--fair); }
  .r-poor { background: var(--poor-bg); color: var(--poor); }
  .r-na   { background: var(--na-bg);   color: var(--na); font-weight: 400; }
  .poor { color: var(--poor); font-weight: 600; }
  .fair { color: var(--fair); }
  td.n .poor { font-weight: 600; }
  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; white-space: nowrap; }
  .why { color: var(--muted); font-size: 0.8125rem; }

  .box { border: 1px solid var(--line-2); border-left: 3px solid var(--accent);
         background: var(--panel); padding: 0.75rem 1rem; margin: 1rem 0; font-size: 0.875rem; }
  .box p:last-child { margin-bottom: 0; }
  .box strong { display: block; }

  details { margin: 0; border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; padding: 0.625rem 0; font-weight: 600; font-size: 0.9375rem; }
  summary span { font-weight: 400; color: var(--muted); font-size: 0.8125rem; }
  details > div { padding: 0 0 1.5rem; }

  ul { margin: 0.25rem 0 0.75rem; padding-left: 1.125rem; }
  li { margin-bottom: 0.25rem; }
  .lim { margin: 0 0 1.125rem; max-width: 46rem; padding-left: 0.75rem;
         border-left: 3px solid var(--line); }
  .lim.important { border-left-color: var(--fair); }
  .lim .h { font-weight: 600; font-size: 0.8125rem; }
  .ok { color: var(--accent); }
  .lim .files { color: var(--muted); font-size: 0.75rem; margin-top: 0.25rem;
                font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
                word-break: break-all; }
  .pages { display: flex; flex-wrap: wrap; gap: 1.5rem; margin: 0.75rem 0 1rem; }
  .page { }
  .pair { display: flex; gap: 0.5rem; }
  .half { }
  .half > .lbl { font-size: 0.625rem; color: var(--faint); text-transform: uppercase;
                 letter-spacing: 0.06em; margin-bottom: 0.1875rem; }
  .pv, .pg { display: block; width: 240px; height: auto; background: var(--pv-page);
             border: 1px solid var(--line-2); }
  .page .cap { font-size: 0.6875rem; color: var(--muted); margin-top: 0.375rem; line-height: 1.3; }
  .key { display: flex; flex-wrap: wrap; gap: 1rem; font-size: 0.75rem; color: var(--muted);
         margin: 0 0 1rem; align-items: center; }
  .key span { display: inline-flex; align-items: center; gap: 0.3125rem; }
  .sw { width: 11px; height: 11px; display: inline-block; border: 1px solid var(--line-2); }
  .filter { display: flex; gap: 0.5rem; align-items: baseline; margin: 0 0 0.75rem; }
  .filter input { font: inherit; font-size: 0.875rem; padding: 0.3125rem 0.5rem;
                  border: 1px solid var(--line-2); background: var(--panel); color: inherit;
                  border-radius: 0; min-width: 18rem; }
  .filter input:focus { outline: 2px solid var(--accent); outline-offset: -1px; }
  .filter .count { font-size: 0.8125rem; color: var(--muted); }
  .pager { display: flex; gap: 0.5rem; align-items: baseline; margin: -0.5rem 0 1rem;
           font-size: 0.8125rem; color: var(--muted); }
  .pager button { font: inherit; padding: 0.125rem 0.5rem; border: 1px solid var(--line-2);
                  background: var(--panel); color: inherit; cursor: pointer; }
  .pager button:disabled { color: var(--faint); cursor: default; }
  @media print { .filter, .pager { display: none; } }
  h4.sec { display: flex; align-items: baseline; gap: 0.5rem; font-size: 0.9375rem;
           color: var(--ink); margin: 1.75rem 0 0.5rem; padding-top: 0.75rem;
           border-top: 1px solid var(--line); }
  h4.sec .tag { font-size: 0.625rem; text-transform: uppercase; letter-spacing: 0.07em;
                font-weight: 600; padding: 0.125rem 0.375rem; border-radius: 2px; }
  .sec-diff .tag { background: var(--na-bg); color: var(--na); }
  .sec-cost .tag { background: var(--good-bg); color: var(--good); }
  .sec-pii  .tag { background: var(--poor-bg); color: var(--poor); }
  .sec-text .tag { background: var(--na-bg); color: var(--na); }
  details.text { border-bottom: 1px solid var(--line); }
  details.text > summary { font-weight: 400; font-size: 0.8125rem; color: var(--muted);
                           padding: 0.375rem 0; }
  details.text pre { margin: 0 0 0.75rem; padding: 0.75rem; background: var(--panel);
                     border: 1px solid var(--line); max-height: 26rem; overflow: auto;
                     font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
                     font-size: 0.75rem; line-height: 1.45; white-space: pre-wrap;
                     word-break: break-word; }
  .tiles { display: flex; flex-wrap: wrap; gap: 1rem; margin: 1rem 0 1.75rem; }
  .tile { flex: 1 1 15rem; background: var(--panel); border: 1px solid var(--line);
          border-radius: 5px; padding: 0.875rem 1rem; }
  .tile .k { font-size: 0.75rem; color: var(--muted); }
  .tile .v { font-size: 1.875rem; font-weight: 600; letter-spacing: -0.02em;
             margin: 0.1875rem 0 0.25rem; }
  .tile .v .u { font-size: 0.9375rem; font-weight: 400; color: var(--faint); }
  .tile .s { font-size: 0.75rem; color: var(--muted); line-height: 1.4; }
  .topline { display: flex; align-items: center; justify-content: space-between;
             gap: 1rem; margin-bottom: 1.25rem; }
  .logo { display: block; margin: 0 0 0 -6px; }
  #theme { font: inherit; font-size: 0.75rem; padding: 0.25rem 0.625rem;
           border: 1px solid var(--line-2); background: var(--panel); color: var(--muted);
           cursor: pointer; border-radius: 3px; }
  #theme:hover { color: var(--ink); }

  /* --- documents explorer -------------------------------------------- */
  .explorer { display: flex; gap: 1.25rem; align-items: flex-start; margin-top: 0.75rem; }
  .files { flex: 0 0 20rem; max-width: 20rem; position: sticky; top: 1rem; }
  .files ul { list-style: none; margin: 0.5rem 0 0; padding: 0;
              border: 1px solid var(--line); border-radius: 4px; overflow: hidden;
              max-height: 34rem; overflow-y: auto; background: var(--panel); }
  .files li { border-bottom: 1px solid var(--line); }
  .files li:last-child { border-bottom: none; }
  .files button { display: flex; width: 100%; gap: 0.5rem; align-items: baseline;
                  text-align: left; font: inherit; font-size: 0.8125rem;
                  padding: 0.5rem 0.625rem; background: none; border: none;
                  color: inherit; cursor: pointer; }
  .files button:hover { background: var(--na-bg); }
  .files button[aria-current="true"] { background: var(--na-bg); font-weight: 600;
                                       box-shadow: inset 3px 0 0 var(--accent); }
  .files .nm { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis;
               white-space: nowrap; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  .files .sc { flex: 0 0 auto; font-size: 0.6875rem; }
  .viewer { flex: 1 1 0; min-width: 0; }
  .viewer > .doc[hidden] { display: none; }
  .doc h3 { margin-top: 0; font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
            font-size: 0.9375rem; }
  .flags { display: flex; flex-wrap: wrap; align-items: center; gap: 0.375rem;
           margin: 0.5rem 0 1.25rem; }
  .flag { display: inline-block; flex: 0 0 auto; font-size: 0.6875rem; line-height: 1.5;
          padding: 0.125rem 0.5rem; border-radius: 3px; white-space: nowrap;
          max-width: 100%; overflow: hidden; text-overflow: ellipsis;
          background: var(--na-bg); color: var(--na); }
  .flag.bad { background: var(--poor-bg); color: var(--poor); }
  .flag.warn { background: var(--fair-bg); color: var(--fair); }
  .flag.ok { background: var(--good-bg); color: var(--good); }
  .subtabs { display: flex; gap: 0.25rem; border-bottom: 1px solid var(--line);
             margin: 0 0 0.875rem; }
  .subtabs button { font: inherit; font-size: 0.8125rem; font-weight: 600;
                    padding: 0.375rem 0.75rem; background: none; border: none;
                    border-bottom: 2px solid transparent; color: var(--muted);
                    cursor: pointer; margin-bottom: -1px; }
  .subtabs button[aria-selected="true"] { color: var(--ink); border-bottom-color: var(--accent); }
  .pcap { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem;
          margin-top: 0.375rem; }
  @media (max-width: 860px) {
    .explorer { flex-direction: column; }
    .files { flex: 1 1 auto; max-width: none; position: static; width: 100%; }
  }
  .drivers { display: flex; flex-wrap: wrap; gap: 2rem; margin: 0.25rem 0 1.25rem; }
  .driver { flex: 1 1 22rem; min-width: 0; }
  .driver > .lbl { font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.06em;
                   color: var(--faint); margin-bottom: 0.375rem;
                   border-bottom: 1px solid var(--line); padding-bottom: 0.25rem; }
  table.bare { margin: 0; table-layout: fixed; }
  table.bare td { border-bottom: none; padding: 0.25rem 0.5rem 0 0; }
  table.bare tr.d-head td { font-weight: 600; font-size: 0.8125rem; padding-top: 0.5rem; }
  table.bare tr.d-why td { padding: 0 0 0.5rem; border-bottom: 1px solid var(--line); }
  table.bare td.v { white-space: normal; font-weight: 400; color: var(--ink-2);
                    font-size: 0.8125rem; text-align: right; width: 42%; }
  table.bare td.n { width: 3rem; }
  .wt { font-size: 0.6875rem; color: var(--faint); }
  .warn { border: 1px solid var(--fair); border-left-width: 3px; background: var(--fair-bg);
          padding: 0.625rem 0.875rem; margin: 0.75rem 0; font-size: 0.8125rem; }
  .warn ul { margin: 0.25rem 0 0; }
  details.more { border: none; margin: 0.5rem 0 0; }
  details.more > summary { font-weight: 400; font-size: 0.8125rem; color: var(--muted);
                           padding: 0.375rem 0; }
  details.more > summary::marker { color: var(--faint); }
  footer { margin-top: 4rem; padding-top: 1.5rem; border-top: 2px solid var(--accent); }
  .foot-main { display: flex; flex-wrap: wrap; gap: 2.5rem; align-items: flex-start; }
  .foot-main > div:first-child { flex: 1 1 18rem; }
  footer .logo { width: 170px; height: auto; margin: 0 0 0.5rem -5px; }
  .foot-claim { font-size: 0.8125rem; color: var(--muted); max-width: 32ch; margin: 0; }
  .foot-meta { flex: 1 1 22rem; display: grid; grid-template-columns: auto 1fr;
               gap: 0.25rem 1rem; margin: 0; font-size: 0.75rem; }
  .foot-meta dt { color: var(--faint); white-space: nowrap; }
  .foot-meta dd { margin: 0; color: var(--ink-2); overflow-wrap: anywhere; }
  .foot-rule { margin-top: 1.5rem; padding-top: 0.75rem; border-top: 1px solid var(--line);
               color: var(--faint); font-size: 0.6875rem; }
  @media print {
    body { padding: 0; max-width: none; font-size: 10.5pt; background: #fff; color: #000; }
    details > div { display: block !important; }
    summary { list-style: none; }
    h2 { break-after: avoid; }
    tr, .lim { break-inside: avoid; }
  }

  /* --- page chrome --------------------------------------------------- */
  nav.tabs { display: flex; gap: 0.25rem; margin: 1.25rem 0 0; border-bottom: 1px solid var(--line-2);
             flex-wrap: wrap; }
  nav.tabs a { padding: 0.5rem 0.875rem; font-size: 0.875rem; font-weight: 600;
               color: var(--muted); text-decoration: none; border: 1px solid transparent;
               border-bottom: none; margin-bottom: -1px; border-radius: 3px 3px 0 0; }
  nav.tabs a:hover { color: var(--ink); }
  nav.tabs a[aria-current="page"] { color: var(--ink); background: var(--paper);
                                    border-color: var(--line-2); }
  nav.tabs .n { font-weight: 400; color: var(--faint); margin-left: 0.3125rem; }
  section[data-page] > h2:first-child { border-top: none; margin-top: 1.5rem; padding-top: 0; }
  .legend { display: flex; flex-wrap: wrap; gap: 1rem; font-size: 0.75rem; color: var(--muted);
            margin: 0 0 0.5rem; }
  .legend span { display: inline-flex; align-items: center; gap: 0.375rem; }
  .legend i { width: 11px; height: 11px; border-radius: 2px; display: inline-block; }
  .chart { display: block; max-width: 100%; margin: 0.25rem 0 1rem; }
  .chart .grp { transition: transform 0.26s cubic-bezier(0.4, 0, 0.2, 1),
                             opacity 0.16s ease; }
  .chart .grp.out { opacity: 0; pointer-events: none; }
  @media (prefers-reduced-motion: reduce) {
    .chart .grp { transition: none; }
  }
  .providers { display: flex; flex-wrap: wrap; gap: 0.375rem; margin: 0 0 1rem; }
  .providers button { font: inherit; font-size: 0.75rem; padding: 0.1875rem 0.625rem;
                      border: 1px solid var(--line-2); background: var(--panel);
                      color: var(--muted); border-radius: 3px; cursor: pointer; }
  .providers button:hover { color: var(--ink); }
  .providers button[aria-pressed="true"] { background: var(--accent); border-color: var(--accent);
                                           color: #fff; }
  .foot-meta dd.opts { font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
                       font-size: 0.6875rem; }
  .lims { max-height: none; }
  .pair-text { display: flex; gap: 0.75rem; }
  .pair-text .half-text { flex: 1 1 0; min-width: 0; }
  .pair-text .lbl { font-size: 0.625rem; color: var(--faint); text-transform: uppercase;
                    letter-spacing: 0.06em; margin: 0 0 0.25rem; }
  @media print { nav.tabs { display: none; } section[data-page] { display: block !important; } }
</style>
</head>
<body>

{% macro plural(n, word, suffix="s") %}{{ n }} {{ word }}{{ "" if n == 1 else suffix }}{% endmacro %}

{% macro matches_table(rows, show_doc) %}
<div class="scroll"><table data-paginate="25">
  <thead><tr>
    {% if show_doc %}<th>Document</th>{% endif %}
    <th class="n">Page</th><th class="n">Line</th><th>Category</th><th>Severity</th>
    <th>Value</th>{% if report.run.reveal_used %}<th>Revealed</th>{% endif %}<th>Matched because</th>
  </tr></thead>
  <tbody>
  {% for doc, m in rows %}
    <tr>
      {% if show_doc %}<td class="mono">{{ doc.relative_path }}</td>{% endif %}
      <td class="n">{{ m.page }}</td><td class="n">{{ m.line }}</td>
      <td>{{ m.label }}</td><td>{{ severity_badge(m.severity) | safe }}</td>
      <td class="mono">{{ m.masked }}</td>
      {% if report.run.reveal_used %}<td class="mono">{{ m.revealed if m.revealed else "—" }}</td>{% endif %}
      <td class="why">
        {%- if m.validators_passed %}passed {{ m.validators_passed | join(", ") }}{% endif -%}
        {%- if m.context_term %}{% if m.validators_passed %}; {% endif %}near "{{ m.context_term }}"{% endif -%}
        {%- if not m.validators_passed and not m.context_term %}pattern match{% endif -%}
      </td>
    </tr>
  {% endfor %}
  </tbody>
</table></div>
{% endmacro %}

<div class="topline">
  {{ logo_svg | safe }}
  <button type="button" id="theme" hidden aria-pressed="false">Dark</button>
</div>
<div class="head">
  <h1>Document audit</h1>
  <p class="meta">{{ report.run.target }}</p>
  <p class="meta">{{ report.run.finished_at }} · complydoc {{ report.run.tool_version }} ·
    {{ report.run.components_run | join(", ") }}</p>
</div>

{% if report.run.reveal_used %}
<div class="box"><strong>This report contains unmasked sensitive values.</strong>
  <p>Generated with <code>--reveal</code>. Handle it with the same care as the documents it
  describes.</p></div>
{% endif %}

{% set agg = report.aggregate %}
<nav class="tabs" id="tabs">
  <a href="#summary" data-tab="summary">Summary</a>
  <a href="#cost" data-tab="cost">Cost</a>
  <a href="#security" data-tab="security">Security<span class="n">{{ agg.sensitive_total }}</span></a>
  <a href="#documents" data-tab="documents">Documents<span class="n">{{ agg.documents_audited }}</span></a>
</nav>
<main>

{# ============================================================ SUMMARY #}
<section data-page id="summary">
<h2>What this folder looks like</h2>

{% set cheapest = comparisons | map(attribute="architectures") | map("first") | list %}
<div class="tiles">
  <div class="tile">
    <div class="k">Cost per 1,000 documents</div>
    {% if comparisons %}
      {% set best = comparisons | last %}
      {% set ocr = best.by_key("text_ocr") %}
      {% set vis = best.by_key("vision") %}
      <div class="v">{{ money(ocr.per_1000_usd) if ocr.per_1000_usd is not none else "—" }}</div>
      <div class="s">reading the text, on {{ best.display_name }}.
        {% if vis.per_1000_usd is not none %}Up to {{ money(vis.per_1000_usd) }} if every page
        is sent as an image.{% endif %}</div>
    {% else %}<div class="v">—</div><div class="s">cost was not part of this run</div>{% endif %}
  </div>

  <div class="tile">
    <div class="k">Average quality</div>
    {% if agg.mean_difficulty_score is not none %}
      <div class="v">{{ agg.mean_difficulty_score | round | int }}<span class="u">/100</span></div>
      <div class="s">
        {% set bands = agg.difficulty_bands %}
        {{ bands.get("straightforward", 0) + bands.get("workable", 0) }} of
        {{ agg.documents_audited }} are workable or better. Higher is easier.</div>
    {% else %}<div class="v">—</div><div class="s">difficulty was not part of this run</div>{% endif %}
  </div>

  <div class="tile">
    <div class="k">Sensitive items per document</div>
    {% if "sensitive" in report.run.components_run %}
      <div class="v">{{ "%.1f"|format(agg.sensitive_total / agg.documents_audited) if agg.documents_audited else 0 }}</div>
      <div class="s">{{ agg.sensitive_total }} found in
        {{ agg.documents_with_sensitive_data }} of {{ agg.documents_audited }} documents.
        {% if agg.counts_by_severity_high is defined %}{% endif %}
        {% set high = agg.sensitive_by_severity.get("high", 0) %}
        {{ high }} rated high severity.</div>
    {% else %}<div class="v">—</div><div class="s">the sensitive scan was not part of this run</div>{% endif %}
  </div>
</div>

{% if per_1000_chart %}
<h3>Cost per 1,000 documents</h3>
<div class="legend">
  {% for key, label, colour in series %}
    <span><i style="background:{{ colour }}"></i>{{ label }}</span>
  {% endfor %}
</div>
{{ per_1000_chart | safe }}
{% endif %}

{% if report.staleness_warnings %}
<div class="box"><strong>Unverified prices</strong>
  <ul>{% for w in report.staleness_warnings %}<li>{{ w }}</li>{% endfor %}</ul></div>
{% endif %}

<details class="more">
  <summary>Run detail — {{ plural(agg.documents_audited, "document") }},
    {{ plural(agg.pages_total, "page") }}{% if agg.documents_skipped %},
    {{ agg.documents_skipped }} skipped{% endif %}</summary>
  <div>
  <table><tbody>
    <tr><td>Documents audited</td><td class="n">{{ agg.documents_audited }}</td>
        <td class="why">{{ plural(agg.pages_total, "page") }}</td></tr>
    {% if agg.pages_unreadable %}
    <tr><td>Pages not read</td><td class="n">{{ agg.pages_unreadable }}</td>
        <td class="why">not searched for sensitive data</td></tr>{% endif %}
    <tr><td>Network guard</td>
        <td class="n">{% if report.run.offline_guard == "armed" %}<span class="ok">armed</span>{% else %}<span class="poor">{{ report.run.offline_guard }}</span>{% endif %}</td>
        <td class="why">no document content left this machine</td></tr>
  </tbody></table>
  {% if report.skipped %}
  <div class="scroll"><table data-paginate="15">
    <thead><tr><th>File not examined</th><th>Reason</th></tr></thead>
    <tbody>{% for sk in report.skipped %}
      <tr><td class="mono">{{ sk.path.name }}</td><td class="why">{{ sk.reason }}</td></tr>
    {% endfor %}</tbody>
  </table></div>
  {% endif %}
  </div>
</details>
</section>

{# =============================================================== COST #}
<section data-page id="cost" hidden>
<h2>Cost</h2>
{% if comparisons %}
<div class="legend">
  {% for key, label, colour in series %}
    <span><i style="background:{{ colour }}"></i>{{ label }}</span>
  {% endfor %}
</div>
{% set providers = comparisons | map(attribute="provider") | unique | sort | list %}
{% if providers | length > 1 %}
<div class="providers" id="providers">
  <button type="button" data-provider="" aria-pressed="true">All providers</button>
  {% for provider in providers %}
    <button type="button" data-provider="{{ provider }}" aria-pressed="false">{{ provider }}</button>
  {% endfor %}
</div>
{% endif %}
<h3>Cost for this folder</h3>
{{ folder_chart | safe }}
{% if annual_chart %}
<h3>Annual cost at {{ "{:,}".format(report.run.monthly_volume) }} documents a month</h3>
{{ annual_chart | safe }}
{% endif %}

<h3>Per document</h3>
{% set cheapest = comparisons | last %}
<div class="scroll"><table data-paginate="20">
  <thead><tr><th>Document</th><th class="n">Pages</th>
    <th class="n">Text</th><th class="n">Vision</th></tr></thead>
  <tbody>
  {% for doc in report.documents %}{% if doc.cost %}
    {% set m = doc.cost.models | selectattr("model_id", "equalto", cheapest.model_id) | first %}
    <tr><td class="mono">{{ doc.relative_path }}</td><td class="n">{{ doc.page_count }}</td>
      <td class="n">{{ money(m.text_path_input_usd) if m and m.text_path_input_usd is not none else "n/a" }}</td>
      <td class="n">{{ money(m.vision_input_usd_by_resolution.get(report.cost.headline_resolution)) if m and m.vision_input_usd_by_resolution.get(report.cost.headline_resolution) is not none else "n/a" }}</td>
    </tr>
  {% endif %}{% endfor %}
  </tbody>
</table></div>
<p class="note">Priced on {{ cheapest.display_name }}, the cheapest model in the comparison.
Multiply by the ratio in the chart above for any other.</p>
{% else %}
<p class="note">Cost was not part of this run.</p>
{% endif %}
</section>

{# =========================================================== SECURITY #}
<section data-page id="security" hidden>
<h2>Sensitive information</h2>
{% if "sensitive" not in report.run.components_run %}
<p class="note">The sensitive data scan was not part of this run.</p>
{% else %}
<p class="note">Masked to the last {{ report.config_masking.reveal_tail_chars }} characters{% if report.config_masking.never_reveal %};
{{ report.config_masking.never_reveal | join(" and ") }} never shown in full{% endif %}.</p>

{% if agg.sensitive_by_category %}
<h3>By category</h3>
<div class="scroll"><table>
  <thead><tr><th>Category</th><th>Region</th><th>Severity</th><th class="n">Count</th>
    <th>Note</th></tr></thead>
  <tbody>
  {% for cat, count in agg.sensitive_by_category | dictsort(by='value', reverse=true) %}
    {% set m = category_meta(cat) %}
    <tr><td>{{ m.label }}</td><td><span class="flag">{{ m.region }}</span></td>
        <td>{{ severity_badge(m.severity) | safe }}</td>
        <td class="n">{{ count }}</td><td class="why">{{ m.note }}</td></tr>
  {% endfor %}
  </tbody>
</table></div>

<h3>Every occurrence</h3>
{% set rows = [] %}
{% for doc in report.documents %}{% if doc.sensitive %}{% for m in doc.sensitive.matches %}
  {% set _ = rows.append((doc, m)) %}
{% endfor %}{% endif %}{% endfor %}
{{ matches_table(rows, true) }}
{% else %}
<p class="note">Nothing detected in the text that could be read. Check the limitations
before reading that as an all-clear.</p>
{% endif %}

{% if agg.categories_not_scanned %}
<h3>Categories not scanned</h3>
<div class="scroll"><table>
  <thead><tr><th>Category</th><th>Why not</th></tr></thead>
  <tbody>{% for cat, reason in agg.categories_not_scanned | dictsort %}
    <tr><td>{{ category_meta(cat).label }}</td><td class="why">{{ reason }}</td></tr>
  {% endfor %}</tbody>
</table></div>
<p class="note">These count zero because nothing looked, not because nothing is there.</p>
{% endif %}
{% endif %}
</section>

{# ========================================================== DOCUMENTS #}
<section data-page id="documents" hidden>
<h2>Documents</h2>

{% if agg.signal_distribution %}
<details class="more">
  <summary>Difficulty signals across the whole folder</summary>
  <div class="scroll"><table>
    <thead><tr><th>Signal</th>{% if report.signal_weights %}<th class="n">Weight</th>{% endif %}
      <th class="n">Good</th><th class="n">Fair</th><th class="n">Poor</th><th class="n">N/A</th></tr></thead>
    <tbody>
    {% for sid, d in agg.signal_distribution | dictsort %}
      <tr><td>{{ signal_name(sid) }}</td>
        {% if report.signal_weights %}<td class="n">{{ "%.2f"|format(report.signal_weights.get(sid, 0)) }}</td>{% endif %}
        <td class="n">{% if d.good %}<span style="color:var(--good)">{{ d.good }}</span>{% endif %}</td>
        <td class="n">{% if d.fair %}<span style="color:var(--fair)">{{ d.fair }}</span>{% endif %}</td>
        <td class="n">{% if d.poor %}<span class="poor">{{ d.poor }}</span>{% endif %}</td>
        <td class="n">{% if d.not_applicable %}<span style="color:var(--na)">{{ d.not_applicable }}</span>{% endif %}</td></tr>
    {% endfor %}
    </tbody>
  </table></div>
</details>
{% endif %}

<div class="explorer" id="explorer">
  <aside class="files">
    <div class="filter">
      <input type="search" id="docfilter" placeholder="Filter files" aria-label="Filter files">
    </div>
    <div class="count" id="doccount"></div>
    <ul id="filelist">
    {% for doc in report.documents %}
      {%- set poor = doc.difficulty.signals | selectattr("rating", "equalto", "poor") | list if doc.difficulty else [] -%}
      {%- set sources = doc.extracted_text | map(attribute="source") | list -%}
      {%- set haystack = [doc.relative_path, doc.format]
            + (poor | map(attribute="name") | list)
            + sources
            + ([doc.difficulty.score.label] if doc.difficulty and doc.difficulty.score else []) -%}
      <li data-search="{{ haystack | join(' ') | lower }}">
        <button type="button" data-doc="{{ loop.index0 }}">
          <span class="nm">{{ doc.relative_path }}</span>
          {% if doc.difficulty and doc.difficulty.score %}
            <span class="sc r r-{{ score_band(doc.difficulty.score.value) }}">{{ doc.difficulty.score.value | round | int }}</span>
          {% else %}<span class="sc r r-na">—</span>{% endif %}
        </button>
      </li>
    {% endfor %}
    </ul>
  </aside>

  <div class="viewer" id="viewer">
  {% for doc in report.documents %}
    <div class="doc" data-doc="{{ loop.index0 }}" hidden>
      <h3>{{ doc.relative_path }}</h3>
      <div class="flags">
        <span class="flag">{{ doc.format }}</span>
        <span class="flag">{{ doc.page_count }} page{{ "" if doc.page_count == 1 else "s" }}{% if not doc.page_count_known %}, not fixed{% endif %}</span>
        {% if doc.difficulty and doc.difficulty.score %}
          <span class="flag {{ 'ok' if score_band(doc.difficulty.score.value) == 'good' else ('warn' if score_band(doc.difficulty.score.value) == 'fair' else 'bad') }}">
            {{ doc.difficulty.score.label }}, {{ doc.difficulty.score.value }}/100</span>
        {% endif %}
        {% for s in doc.difficulty.signals | selectattr("rating", "equalto", "poor") | list if doc.difficulty %}
          <span class="flag bad" title="{{ s.why }}">{{ s.name | lower }}: {{ s.display }}</span>
        {% endfor %}
        {% if doc.sensitive and doc.sensitive.unreadable_pages %}
          <span class="flag bad">{{ plural(doc.sensitive.unreadable_pages | length, "page") }}
            not read</span>
        {% endif %}
      </div>
      {% if doc.sensitive and doc.sensitive.unreadable_pages %}
        <p class="note"><strong>Page {{ doc.sensitive.unreadable_pages | join(", ") }} carried no
        readable text and {{ "was" if doc.sensitive.unreadable_pages | length == 1 else "were" }}
        not searched.</strong> Nothing was found there because nothing looked.</p>
      {% endif %}

      {% if doc.load_warnings %}
        <div class="warn"><strong>Reading this document was incomplete.</strong>
          <ul>{% for w in doc.load_warnings %}<li>{{ w }}</li>{% endfor %}</ul></div>
      {% endif %}

      <div class="subtabs" role="tablist">
        <button type="button" data-view="pages" aria-selected="true">Pages</button>
        <button type="button" data-view="text" aria-selected="false">Extracted text</button>
        <button type="button" data-view="ocr" aria-selected="false">What OCR sees</button>
        <button type="button" data-view="signals" aria-selected="false">All signals</button>
      </div>

      <div data-view="pages">
        {% if doc.previews %}
        <div class="key">
          <span><i class="sw" style="background:var(--pv-text);border-color:var(--pv-text)"></i> text</span>
          <span><i class="sw" style="background:var(--pv-image);border-color:var(--pv-image)"></i> image, needs OCR or vision</span>
          <span><i class="sw" style="background:transparent;border-color:var(--poor)"></i> sensitive, high</span>
          <span><i class="sw" style="background:transparent;border-color:var(--fair)"></i> sensitive, other</span>
        </div>
        <div class="pages">
        {% for pv in doc.previews[:max_preview_pages] %}
          <div class="page">
            <div class="pair">
              {% if pv.image_data_uri %}
              <div class="half"><div class="lbl">document</div>
                <img class="pg" src="{{ pv.image_data_uri }}" alt="Page {{ pv.number }}" loading="lazy"></div>
              {% endif %}
              <div class="half"><div class="lbl">{{ "extracted" if pv.image_data_uri else "layout" }}</div>
                {{ page_preview_svg(pv) | safe }}</div>
            </div>
            <div class="cap">page {{ pv.number }}</div>
            <div class="pcap">
              {% for level, label in pv.flags %}<span class="flag {{ level }}">{{ label }}</span>{% endfor %}
            </div>
          </div>
        {% endfor %}
        </div>
        {% if doc.previews | length > max_preview_pages %}
          <p class="note">Showing the first {{ max_preview_pages }} of {{ doc.previews | length }} pages.</p>
        {% endif %}
        {% else %}<p class="note">No pages could be read from this document.</p>{% endif %}
      </div>

      <div data-view="text" hidden>
        {% if doc.extracted_text %}
          {% for pt in doc.extracted_text %}
            <details class="text" {% if loop.first %}open{% endif %}>
              <summary>Page {{ pt.number }} — {{ "{:,}".format(pt.characters) }} characters,
                read as {{ pt.source }}{% if pt.truncated %}, truncated{% endif %}</summary>
              {% if pt.text.strip() %}<pre>{{ pt.text }}</pre>
              {% else %}<p class="note">Nothing was read from this page.</p>{% endif %}
            </details>
          {% endfor %}
        {% else %}
          <p class="note">Run with <code>--extracted-text</code> to include the text read off
          each page.</p>
        {% endif %}
      </div>

      <div data-view="ocr" hidden>
        {% set any_ocr = doc.extracted_text | selectattr("ocr_text") | list %}
        {% if any_ocr %}
          {% for pt in doc.extracted_text %}
            {% if pt.ocr_text %}
            <details class="text" {% if loop.first %}open{% endif %}>
              <summary>Page {{ pt.number }} — OCR read
                {{ "{:,}".format(pt.ocr_text | length) }} characters</summary>
              <pre>{{ pt.ocr_text }}</pre>
            </details>
            {% endif %}
          {% endfor %}
        {% else %}
          <p class="note">No OCR output. OCR runs only where there is no text layer; add
          <code>--ocr-compare</code> to read every page.</p>
        {% endif %}
      </div>

      <div data-view="signals" hidden>
        {% if doc.difficulty %}
        <div class="scroll"><table>
          <thead><tr><th>Signal</th><th>Measured</th><th>Rating</th>
            {% if report.signal_weights %}<th class="n">Weight</th>{% endif %}<th>Why it matters</th></tr></thead>
          <tbody>
          {% for s in doc.difficulty.signals %}
            <tr><td>{{ s.name }}</td>
              <td>{{ s.display }}{% if s.reason %}<div class="why">{{ s.reason }}</div>{% endif %}</td>
              <td>{% if s.rating %}<span class="r r-{{ s.rating }}">{{ s.rating }}</span>{% else %}<span class="r r-na">{{ s.status.replace("_", " ") }}</span>{% endif %}</td>
              {% if report.signal_weights %}<td class="n">{{ "%.2f"|format(s.weight) }}</td>{% endif %}
              <td class="why">{{ s.why }}</td></tr>
          {% endfor %}
          </tbody>
        </table></div>
        {% set skipped = doc.difficulty.signals | rejectattr("rating") | list %}
        {% if skipped %}
        <details class="more">
          <summary>{{ plural(skipped | length, "signal") }} not measured for this document</summary>
          <div class="scroll"><table>
            <thead><tr><th>Signal</th><th>Why not</th></tr></thead>
            <tbody>{% for sg in skipped %}
              <tr><td>{{ sg.name }}</td><td class="why">{{ sg.reason or sg.status }}</td></tr>
            {% endfor %}</tbody>
          </table></div>
        </details>
        {% endif %}
        {% endif %}
        {% if doc.cost %}
        <div class="scroll"><table data-paginate="15">
          <thead><tr><th class="n">Page</th><th>Size</th><th class="n">Scan DPI</th><th>Text</th>
            <th class="n">Text coverage</th></tr></thead>
          <tbody>{% for pg in doc.cost.pages %}
            <tr><td class="n">{{ pg.number }}</td><td>{{ pg.size_label }}</td>
              <td class="n">{{ pg.dpi if pg.dpi else "—" }}</td><td>{{ pg.text_source }}</td>
              <td class="n">{{ "%.1f"|format(pg.text_coverage_pct) }}%</td></tr>
          {% endfor %}</tbody>
        </table></div>
        {% endif %}
        <p class="note">SHA-256 <code>{{ doc.sha256 }}</code></p>
      </div>
    </div>
  {% else %}
    <p class="note">No documents were audited.</p>
  {% endfor %}
  </div>
</div>
</section>

</main>

<footer>
  <div class="foot-main">
    <div>
      {{ logo_svg | safe }}
      <p class="foot-claim">No document content left this machine. Outbound network access
      was blocked for the whole run.</p>
    </div>
    <dl class="foot-meta">
      <dt>Audited</dt><dd>{{ report.run.target }}</dd>
      <dt>Finished</dt><dd>{{ report.run.finished_at }} in {{ "%.1f"|format(report.run.duration_seconds) }}s</dd>
      <dt>Documents</dt><dd>{{ agg.documents_audited }} across {{ agg.pages_total }} page{{ "" if agg.pages_total == 1 else "s" }}{% if agg.documents_skipped %}, {{ agg.documents_skipped }} skipped{% endif %}</dd>
      <dt>Read by</dt><dd>text layer{% if report.run.ocr_available and report.run.ocr_requested %}, local OCR{% endif %}{% if report.run.ner_available %}, local name detection{% endif %}</dd>
      <dt>Priced against</dt><dd>{{ plural(comparisons | length, "model") }}</dd>
      <dt>Options</dt><dd class="opts">{{ run_options }}</dd>
    </dl>
  </div>
  <div class="foot-rule">
    complydoc {{ report.run.tool_version }} · report schema v{{ report.run.schema_version }} ·
    config {{ report.run.config_digest }} · Python {{ report.run.python_version }} ·
    network guard {{ report.run.offline_guard }}
  </div>
</footer>

<script>
/* Progressive enhancement only: with scripting off, every document and every
   table row is already on the page. This adds a filter and pagination for runs
   large enough that scrolling stops working. */
(function () {
  "use strict";


  function providerFilter() {
    var bar = document.getElementById("providers");
    if (!bar) return;
    var buttons = Array.prototype.slice.call(bar.querySelectorAll("button"));
    var charts = Array.prototype.slice.call(document.querySelectorAll("svg.chart"));
    var still = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var DURATION = still ? 0 : 260;

    // The viewBox is an attribute, so CSS cannot transition it. Without tweening
    // it the chart snapped to its new height while the bars were still sliding,
    // which read as a jump rather than a filter.
    function resize(svg, to) {
      var box = svg.getAttribute("viewBox").split(" ");
      var from = parseFloat(box[3]);
      var axis = svg.querySelector("line.axis");
      if (svg._tween) cancelAnimationFrame(svg._tween);

      function paint(height) {
        svg.setAttribute("viewBox", box[0] + " " + box[1] + " " + box[2] + " " + height);
        svg.setAttribute("height", height);
        if (axis) axis.setAttribute("y2", Math.max(0, height - 16));
      }
      if (!DURATION || from === to) {
        paint(to);
        return;
      }
      var started = performance.now();
      function frame(now) {
        var t = Math.min(1, (now - started) / DURATION);
        var eased = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
        paint(from + (to - from) * eased);
        if (t < 1) svg._tween = requestAnimationFrame(frame);
      }
      svg._tween = requestAnimationFrame(frame);
    }

    function apply(provider) {
      buttons.forEach(function (b) {
        b.setAttribute("aria-pressed", String(b.getAttribute("data-provider") === provider));
      });
      charts.forEach(function (svg) {
        var step = parseFloat(svg.getAttribute("data-step"));
        var top = parseFloat(svg.getAttribute("data-top"));
        var groups = Array.prototype.slice.call(svg.querySelectorAll("g.grp"));
        var shown = 0;
        groups.forEach(function (g) {
          var keep = !provider || g.getAttribute("data-provider") === provider;
          if (keep) {
            // Slide into the slot the hidden rows vacated rather than reflowing.
            g.setAttribute("transform", "translate(0," + (top + shown * step) + ")");
            g.classList.remove("out");
            shown++;
          } else {
            g.classList.add("out");
          }
        });
        resize(svg, top + Math.max(shown, 1) * step);
      });
    }
    buttons.forEach(function (b) {
      b.addEventListener("click", function () { apply(b.getAttribute("data-provider")); });
    });
  }

  function explorer() {
    var root = document.getElementById("explorer");
    if (!root) return;
    var items = Array.prototype.slice.call(root.querySelectorAll("#filelist > li"));
    var docs = Array.prototype.slice.call(root.querySelectorAll(".viewer > .doc"));
    var input = document.getElementById("docfilter");
    var count = document.getElementById("doccount");
    if (!items.length) return;

    function select(index) {
      docs.forEach(function (d) { d.hidden = d.getAttribute("data-doc") !== index; });
      items.forEach(function (li) {
        var button = li.querySelector("button");
        if (button.getAttribute("data-doc") === index) button.setAttribute("aria-current", "true");
        else button.removeAttribute("aria-current");
      });
    }

    items.forEach(function (li) {
      li.querySelector("button").addEventListener("click", function () {
        select(li.querySelector("button").getAttribute("data-doc"));
      });
    });

    function firstVisible() {
      var li = items.filter(function (x) { return !x.hidden; })[0];
      return li ? li.querySelector("button").getAttribute("data-doc") : null;
    }

    function apply() {
      // Matches the file name, format, text source and the signals actually rated
      // poor — not the explanatory prose, which is identical in every document and
      // made a search for "rotated" return the whole folder.
      var q = input ? input.value.trim().toLowerCase() : "";
      var shown = 0;
      items.forEach(function (li) {
        var hit = !q || (li.getAttribute("data-search") || "").indexOf(q) !== -1;
        li.hidden = !hit;
        if (hit) shown++;
      });
      if (count) {
        count.textContent = q
          ? shown + " of " + items.length + " files"
          : items.length + (items.length === 1 ? " file" : " files");
      }
      var current = docs.filter(function (d) { return !d.hidden; })[0];
      var visible = firstVisible();
      if (visible && (!current || items.filter(function (li) {
        return !li.hidden && li.querySelector("button").getAttribute("data-doc") ===
          current.getAttribute("data-doc");
      }).length === 0)) {
        select(visible);
      }
    }

    if (input) input.addEventListener("input", apply);
    apply();
    select(items[0].querySelector("button").getAttribute("data-doc"));

    docs.forEach(function (doc) {
      var buttons = Array.prototype.slice.call(doc.querySelectorAll(".subtabs button"));
      var views = Array.prototype.slice.call(doc.querySelectorAll("[data-view]"))
        .filter(function (v) { return v.tagName !== "BUTTON"; });
      buttons.forEach(function (button) {
        button.addEventListener("click", function () {
          var want = button.getAttribute("data-view");
          buttons.forEach(function (b) {
            b.setAttribute("aria-selected", String(b === button));
          });
          views.forEach(function (v) { v.hidden = v.getAttribute("data-view") !== want; });
        });
      });
    });
  }

  function theme() {
    var button = document.getElementById("theme");
    if (!button) return;
    button.hidden = false;
    var root = document.documentElement;

    function current() {
      var set = root.getAttribute("data-theme");
      if (set) return set;
      return window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
    }
    function paint() {
      var dark = current() === "dark";
      button.textContent = dark ? "Light" : "Dark";
      button.setAttribute("aria-pressed", String(dark));
    }
    button.addEventListener("click", function () {
      root.setAttribute("data-theme", current() === "dark" ? "light" : "dark");
      paint();
    });
    paint();
  }

  function paginate(table) {
    var size = parseInt(table.getAttribute("data-paginate"), 10);
    var body = table.tBodies[0];
    if (!body || !size) return;
    var rows = Array.prototype.slice.call(body.rows);
    if (rows.length <= size) return;

    var page = 0;
    var pages = Math.ceil(rows.length / size);

    var bar = document.createElement("div");
    bar.className = "pager";
    var prev = document.createElement("button");
    prev.type = "button";
    prev.textContent = "Previous";
    var next = document.createElement("button");
    next.type = "button";
    next.textContent = "Next";
    var label = document.createElement("span");
    bar.appendChild(prev);
    bar.appendChild(next);
    bar.appendChild(label);
    var host = table.parentNode;
    host.parentNode.insertBefore(bar, host.nextSibling);

    function draw() {
      var first = page * size;
      var last = Math.min(first + size, rows.length);
      rows.forEach(function (row, i) { row.hidden = i < first || i >= last; });
      label.textContent = "Showing " + (first + 1) + "\u2013" + last + " of " + rows.length;
      prev.disabled = page === 0;
      next.disabled = page >= pages - 1;
    }
    prev.addEventListener("click", function () { if (page > 0) { page--; draw(); } });
    next.addEventListener("click", function () { if (page < pages - 1) { page++; draw(); } });
    draw();
  }


  function tabs() {
    var nav = document.getElementById("tabs");
    if (!nav) return;
    var links = Array.prototype.slice.call(nav.querySelectorAll("a"));
    var pages = Array.prototype.slice.call(document.querySelectorAll("section[data-page]"));

    function show(id) {
      var known = pages.some(function (p) { return p.id === id; });
      if (!known) id = pages[0].id;
      pages.forEach(function (p) { p.hidden = p.id !== id; });
      links.forEach(function (a) {
        if (a.getAttribute("data-tab") === id) a.setAttribute("aria-current", "page");
        else a.removeAttribute("aria-current");
      });
      window.scrollTo(0, 0);
    }
    // The click is the mechanism; the hash is a convenience on top of it. Some
    // viewers — a data: URL, a sandboxed mail preview — never report a hash, and
    // relying on it there would leave every tab dead but the first.
    links.forEach(function (a) {
      a.addEventListener("click", function (event) {
        event.preventDefault();
        var id = a.getAttribute("data-tab");
        show(id);
        try {
          history.replaceState(null, "", "#" + id);
        } catch (err) {
          /* file:// and data: URLs may refuse; the view has already switched. */
        }
      });
    });
    window.addEventListener("hashchange", function () {
      show(location.hash.replace("#", ""));
    });
    show(location.hash.replace("#", "") || pages[0].id);
  }

  function paginateList(host) {
    var size = parseInt(host.getAttribute("data-paginate-list"), 10);
    var items = Array.prototype.slice.call(host.children);
    if (!size || items.length <= size) return;
    var page = 0, count = Math.ceil(items.length / size);
    var bar = document.createElement("div");
    bar.className = "pager";
    var prev = document.createElement("button"); prev.type = "button"; prev.textContent = "Previous";
    var next = document.createElement("button"); next.type = "button"; next.textContent = "Next";
    var label = document.createElement("span");
    bar.appendChild(prev); bar.appendChild(next); bar.appendChild(label);
    host.parentNode.insertBefore(bar, host.nextSibling);
    function draw() {
      var first = page * size, last = Math.min(first + size, items.length);
      items.forEach(function (el, i) { el.hidden = i < first || i >= last; });
      label.textContent = "Showing " + (first + 1) + "\u2013" + last + " of " + items.length;
      prev.disabled = page === 0; next.disabled = page >= count - 1;
    }
    prev.addEventListener("click", function () { if (page > 0) { page--; draw(); } });
    next.addEventListener("click", function () { if (page < count - 1) { page++; draw(); } });
    draw();
  }

  tabs();
  Array.prototype.forEach.call(
    document.querySelectorAll("[data-paginate-list]"), paginateList
  );
  explorer();
  providerFilter();
  theme();
  Array.prototype.forEach.call(
    document.querySelectorAll("table[data-paginate]"), paginate
  );
})();
</script>
</body>
</html>
