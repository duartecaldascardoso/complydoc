<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>complydoc — {{ report.run.target }}</title>
<link rel="icon" href="{{ favicon_uri }}">
<style>
  html { -webkit-text-size-adjust: 100%; }
  :root {
    --accent: #1a7f4b; --paper: #fbfbfa; --line: #e8e8e6;
    --good: #1a7f4b; --good-bg: #e8f3ec;
    --fair: #8a5a00; --fair-bg: #fbf1de;
    --poor: #b3261e; --poor-bg: #fbeae8;
    --na:   #6b7280; --na-bg:   #f0f1f3;
  }
  body {
    margin: 0 auto; padding: 2.5rem 1.5rem 6rem; max-width: 60rem;
    background: var(--paper); color: #111;
    font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    font-variant-numeric: tabular-nums;
  }
  .logo { display: block; margin: 0 0 1.25rem -4px; }
  .head { border-bottom: 2px solid var(--accent); padding-bottom: 0.875rem; margin-bottom: 0.5rem; }
  h1 { font-size: 1.375rem; font-weight: 600; margin: 0 0 0.25rem; }
  h2 { font-size: 1rem; font-weight: 600; margin: 2.75rem 0 0.75rem;
       padding-top: 0.75rem; border-top: 1px solid #111; }
  h3 { font-size: 0.9375rem; font-weight: 600; margin: 1.75rem 0 0.5rem; }
  h4 { font-size: 0.8125rem; font-weight: 600; margin: 1.5rem 0 0.375rem; color: #444; }
  p  { margin: 0 0 0.75rem; }
  .meta { color: #666; font-size: 0.8125rem; margin: 0; }
  .note { color: #555; font-size: 0.8125rem; max-width: 46rem; }
  code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 0.875em; }

  table { border-collapse: collapse; width: 100%; margin: 0.5rem 0 1rem; font-size: 0.875rem; }
  th, td { text-align: left; padding: 0.375rem 0.75rem 0.375rem 0; vertical-align: top;
           border-bottom: 1px solid var(--line); }
  th { font-weight: 600; border-bottom: 1px solid #111; white-space: nowrap; }
  td.n, th.n { text-align: right; white-space: nowrap; padding-right: 1.25rem; }
  .scroll { overflow-x: auto; }
  /* Ratings and severities are the two things a reader scans for, so they get
     the colour. Everything else stays monochrome. */
  .r { display: inline-block; padding: 0.0625rem 0.375rem; border-radius: 2px;
       font-size: 0.75rem; font-weight: 600; white-space: nowrap; }
  .r-good { background: var(--good-bg); color: var(--good); }
  .r-fair { background: var(--fair-bg); color: var(--fair); }
  .r-poor { background: var(--poor-bg); color: var(--poor); }
  .r-na   { background: var(--na-bg);   color: var(--na); font-weight: 400; }
  .poor { color: var(--poor); font-weight: 600; }
  .fair { color: var(--fair); }
  td.n .poor { font-weight: 600; }
  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; white-space: nowrap; }
  .why { color: #666; font-size: 0.8125rem; }

  .box { border: 1px solid #111; border-left: 3px solid var(--accent);
         background: #fff; padding: 0.75rem 1rem; margin: 1rem 0; font-size: 0.875rem; }
  .box p:last-child { margin-bottom: 0; }
  .box strong { display: block; }

  details { margin: 0; border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; padding: 0.625rem 0; font-weight: 600; font-size: 0.9375rem; }
  summary span { font-weight: 400; color: #666; font-size: 0.8125rem; }
  details > div { padding: 0 0 1.5rem; }

  ul { margin: 0.25rem 0 0.75rem; padding-left: 1.125rem; }
  li { margin-bottom: 0.25rem; }
  .lim { margin: 0 0 1.125rem; max-width: 46rem; padding-left: 0.75rem;
         border-left: 3px solid var(--line); }
  .lim.important { border-left-color: var(--fair); }
  .lim .h { font-weight: 600; font-size: 0.8125rem; }
  .ok { color: var(--accent); }
  .lim .files { color: #666; font-size: 0.75rem; margin-top: 0.25rem;
                font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
                word-break: break-all; }
  .pages { display: flex; flex-wrap: wrap; gap: 1.5rem; margin: 0.75rem 0 1rem; }
  .page { }
  .pair { display: flex; gap: 0.5rem; }
  .half { }
  .half > .lbl { font-size: 0.625rem; color: #999; text-transform: uppercase;
                 letter-spacing: 0.06em; margin-bottom: 0.1875rem; }
  .pv, .pg { display: block; width: 240px; height: auto; background: #fff;
             border: 1px solid #ccc; }
  .page .cap { font-size: 0.6875rem; color: #666; margin-top: 0.375rem; line-height: 1.3; }
  .key { display: flex; flex-wrap: wrap; gap: 1rem; font-size: 0.75rem; color: #666;
         margin: 0 0 1rem; align-items: center; }
  .key span { display: inline-flex; align-items: center; gap: 0.3125rem; }
  .sw { width: 11px; height: 11px; display: inline-block; border: 1px solid #bbb; }
  .filter { display: flex; gap: 0.5rem; align-items: baseline; margin: 0 0 0.75rem; }
  .filter input { font: inherit; font-size: 0.875rem; padding: 0.3125rem 0.5rem;
                  border: 1px solid #ccc; background: #fff; color: inherit;
                  border-radius: 0; min-width: 18rem; }
  .filter input:focus { outline: 2px solid var(--accent); outline-offset: -1px; }
  .filter .count { font-size: 0.8125rem; color: #666; }
  .pager { display: flex; gap: 0.5rem; align-items: baseline; margin: -0.5rem 0 1rem;
           font-size: 0.8125rem; color: #666; }
  .pager button { font: inherit; padding: 0.125rem 0.5rem; border: 1px solid #ccc;
                  background: #fff; color: inherit; cursor: pointer; }
  .pager button:disabled { color: #bbb; cursor: default; }
  @media print { .filter, .pager { display: none; } }
  h4.sec { display: flex; align-items: baseline; gap: 0.5rem; font-size: 0.9375rem;
           color: #111; margin: 1.75rem 0 0.5rem; padding-top: 0.75rem;
           border-top: 1px solid var(--line); }
  h4.sec .tag { font-size: 0.625rem; text-transform: uppercase; letter-spacing: 0.07em;
                font-weight: 600; padding: 0.125rem 0.375rem; border-radius: 2px; }
  .sec-diff .tag { background: #eceef2; color: #4f5d75; }
  .sec-cost .tag { background: var(--good-bg); color: var(--good); }
  .sec-pii  .tag { background: var(--poor-bg); color: var(--poor); }
  .sec-text .tag { background: #eceef2; color: #4f5d75; }
  details.text { border-bottom: 1px solid var(--line); }
  details.text > summary { font-weight: 400; font-size: 0.8125rem; color: #555;
                           padding: 0.375rem 0; }
  details.text pre { margin: 0 0 0.75rem; padding: 0.75rem; background: #fff;
                     border: 1px solid var(--line); max-height: 26rem; overflow: auto;
                     font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
                     font-size: 0.75rem; line-height: 1.45; white-space: pre-wrap;
                     word-break: break-word; }
  .drivers { display: flex; flex-wrap: wrap; gap: 2rem; margin: 0.25rem 0 1.25rem; }
  .driver { flex: 1 1 22rem; min-width: 0; }
  .driver > .lbl { font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.06em;
                   color: #888; margin-bottom: 0.375rem;
                   border-bottom: 1px solid var(--line); padding-bottom: 0.25rem; }
  table.bare { margin: 0; table-layout: fixed; }
  table.bare td { border-bottom: none; padding: 0.25rem 0.5rem 0 0; }
  table.bare tr.d-head td { font-weight: 600; font-size: 0.8125rem; padding-top: 0.5rem; }
  table.bare tr.d-why td { padding: 0 0 0.5rem; border-bottom: 1px solid #f0f0ee; }
  table.bare td.v { white-space: normal; font-weight: 400; color: #444;
                    font-size: 0.8125rem; text-align: right; width: 42%; }
  table.bare td.n { width: 3rem; }
  .wt { font-size: 0.6875rem; color: #999; }
  .warn { border: 1px solid var(--fair); border-left-width: 3px; background: var(--fair-bg);
          padding: 0.625rem 0.875rem; margin: 0.75rem 0; font-size: 0.8125rem; }
  .warn ul { margin: 0.25rem 0 0; }
  details.more { border: none; margin: 0.5rem 0 0; }
  details.more > summary { font-weight: 400; font-size: 0.8125rem; color: #666;
                           padding: 0.375rem 0; }
  details.more > summary::marker { color: #bbb; }
  footer { margin-top: 3rem; padding-top: 0.75rem; border-top: 1px solid var(--line);
           color: #888; font-size: 0.75rem; }
  @media print {
    body { padding: 0; max-width: none; font-size: 10.5pt; background: #fff; }
    details > div { display: block !important; }
    summary { list-style: none; }
    h2 { break-after: avoid; }
    tr, .lim { break-inside: avoid; }
  }

  /* --- page chrome --------------------------------------------------- */
  nav.tabs { display: flex; gap: 0.25rem; margin: 1.25rem 0 0; border-bottom: 1px solid #d8d8d4;
             flex-wrap: wrap; }
  nav.tabs a { padding: 0.5rem 0.875rem; font-size: 0.875rem; font-weight: 600;
               color: #666; text-decoration: none; border: 1px solid transparent;
               border-bottom: none; margin-bottom: -1px; border-radius: 3px 3px 0 0; }
  nav.tabs a:hover { color: #111; }
  nav.tabs a[aria-current="page"] { color: #111; background: #fff;
                                    border-color: #d8d8d4; }
  nav.tabs .n { font-weight: 400; color: #999; margin-left: 0.3125rem; }
  section[data-page] > h2:first-child { border-top: none; margin-top: 1.5rem; padding-top: 0; }
  .legend { display: flex; flex-wrap: wrap; gap: 1rem; font-size: 0.75rem; color: #555;
            margin: 0 0 0.5rem; }
  .legend span { display: inline-flex; align-items: center; gap: 0.375rem; }
  .legend i { width: 11px; height: 11px; border-radius: 2px; display: inline-block; }
  .chart { display: block; max-width: 100%; margin: 0.25rem 0 0.5rem; }
  .lims { max-height: none; }
  .pair-text { display: flex; gap: 0.75rem; }
  .pair-text .half-text { flex: 1 1 0; min-width: 0; }
  .pair-text .lbl { font-size: 0.625rem; color: #999; text-transform: uppercase;
                    letter-spacing: 0.06em; margin: 0 0 0.25rem; }
  @media print { nav.tabs { display: none; } section[data-page] { display: block !important; } }
</style>
</head>
<body>

{% macro matches_table(rows, show_doc) %}
<div class="scroll"><table data-paginate="25">
  <thead><tr>
    {% if show_doc %}<th>Document</th>{% endif %}
    <th class="n">Page</th><th class="n">Line</th><th>Category</th><th>Severity</th>
    <th>Value</th>{% if report.run.reveal_used %}<th>Revealed</th>{% endif %}<th>Matched because</th>
  </tr></thead>
  <tbody>
  {% for doc, m in rows %}
    <tr>
      {% if show_doc %}<td class="mono">{{ doc.relative_path }}</td>{% endif %}
      <td class="n">{{ m.page }}</td><td class="n">{{ m.line }}</td>
      <td>{{ m.label }}</td><td>{{ severity_badge(m.severity) | safe }}</td>
      <td class="mono">{{ m.masked }}</td>
      {% if report.run.reveal_used %}<td class="mono">{{ m.revealed if m.revealed else "—" }}</td>{% endif %}
      <td class="why">
        {%- if m.validators_passed %}passed {{ m.validators_passed | join(", ") }}{% endif -%}
        {%- if m.context_term %}{% if m.validators_passed %}; {% endif %}near "{{ m.context_term }}"{% endif -%}
        {%- if not m.validators_passed and not m.context_term %}pattern match{% endif -%}
      </td>
    </tr>
  {% endfor %}
  </tbody>
</table></div>
{% endmacro %}

{{ logo_svg | safe }}
<div class="head">
  <h1>Document audit</h1>
  <p class="meta">{{ report.run.target }}</p>
  <p class="meta">{{ report.run.finished_at }} · complydoc {{ report.run.tool_version }} ·
    {{ report.run.components_run | join(", ") }}</p>
</div>

{% if report.run.reveal_used %}
<div class="box"><strong>This report contains unmasked sensitive values.</strong>
  <p>Generated with <code>--reveal</code>. Handle it with the same care as the documents it
  describes.</p></div>
{% endif %}
{% if report.run.page_images_used %}
<div class="box"><strong>This report contains pictures of the documents.</strong>
  <p>Generated with <code>--page-images</code>, so it carries the page content itself.</p></div>
{% endif %}
{% if report.run.extracted_text_used %}
<div class="box"><strong>This report contains the extracted text.</strong>
  <p>Generated with <code>--extracted-text</code>. The text read off every page is reproduced
  in full, so masking the values in the tables no longer protects them.</p></div>
{% endif %}

{% set agg = report.aggregate %}
<nav class="tabs" id="tabs">
  <a href="#summary" data-tab="summary">Summary</a>
  <a href="#cost" data-tab="cost">Cost</a>
  <a href="#security" data-tab="security">Security<span class="n">{{ agg.sensitive_total }}</span></a>
  <a href="#documents" data-tab="documents">Documents<span class="n">{{ agg.documents_audited }}</span></a>
</nav>
<main>

{# ============================================================ SUMMARY #}
<section data-page id="summary">
<h2>Summary</h2>
<table><tbody>
  <tr><td>Documents audited</td><td class="n">{{ agg.documents_audited }}</td>
      <td class="why">{{ agg.pages_total }} page(s){% if agg.documents_skipped %},
        {{ agg.documents_skipped }} file(s) skipped{% endif %}</td></tr>
  {% if agg.total_text_path_usd is not none %}
  <tr><td>Text path, this folder</td><td class="n">{{ money(agg.total_text_path_usd) }}</td>
      <td class="why">input tokens only</td></tr>{% endif %}
  {% if agg.total_vision_path_usd is not none %}
  <tr><td>Vision path, this folder</td><td class="n">{{ money(agg.total_vision_path_usd) }}</td>
      <td class="why">at {{ report.cost.headline_resolution }} resolution</td></tr>{% endif %}
  {% if agg.mean_difficulty_score is not none %}
  <tr><td>Mean difficulty score</td><td class="n">{{ agg.mean_difficulty_score }} / 100</td>
      <td class="why">higher is easier</td></tr>{% endif %}
  {% if "sensitive" in report.run.components_run %}
  <tr><td>Sensitive items found</td><td class="n">{{ agg.sensitive_total }}</td>
      <td class="why">in {{ agg.documents_with_sensitive_data }} of
        {{ agg.documents_audited }} document(s)</td></tr>{% endif %}
  {% if agg.pages_unreadable %}
  <tr><td>Pages not read</td><td class="n">{{ agg.pages_unreadable }}</td>
      <td class="why">not searched for sensitive data</td></tr>{% endif %}
  <tr><td>Network guard</td>
      <td class="n">{% if report.run.offline_guard == "armed" %}<span class="ok">armed</span>{% else %}<span class="poor">{{ report.run.offline_guard }}</span>{% endif %}</td>
      <td class="why">no document content left this machine</td></tr>
</tbody></table>

{% if report.staleness_warnings %}
<div class="box"><strong>Unverified prices</strong>
  <ul>{% for w in report.staleness_warnings %}<li>{{ w }}</li>{% endfor %}</ul></div>
{% endif %}

<h2>Limitations of this run</h2>
<p class="note">Generated from what happened during this run, not a standard disclaimer.
{% set important = report.limitations | selectattr("severity", "equalto", "important") | list %}
{{ important | length }} of {{ report.limitations | length }} are marked important.</p>
<details class="more" open>
  <summary>{{ report.limitations | length }} limitation(s)</summary>
  <div class="lims" data-paginate-list="8">
  {% for lim in report.limitations %}
    <div class="lim{% if lim.severity == 'important' %} important{% endif %}">
      <div class="h">{{ lim.area }}{% if lim.severity == "important" %} — important{% endif %}</div>
      <div class="why">{{ lim.statement }}</div>
      {% if lim.affected %}<div class="files">{{ lim.affected | join(" · ") }}</div>{% endif %}
    </div>
  {% else %}
    <p class="note">Nothing was skipped and every configured check ran on every document.</p>
  {% endfor %}
  </div>
</details>

{% if report.skipped %}
<h3>Files skipped</h3>
<div class="scroll"><table data-paginate="15">
  <thead><tr><th>File</th><th>Reason</th><th>Detail</th></tr></thead>
  <tbody>{% for s in report.skipped %}
    <tr><td class="mono">{{ s.path.name }}</td><td>{{ s.reason }}</td>
        <td class="why">{{ s.detail or "—" }}</td></tr>
  {% endfor %}</tbody>
</table></div>
{% endif %}
</section>

{# =============================================================== COST #}
<section data-page id="cost" hidden>
<h2>Cost</h2>
{% if comparisons %}
<p class="note">Three ways to get a document in front of a model. Cost alone favours the
text layer, but it only reaches documents that have one — so reach is shown beside every
figure.</p>
<div class="legend">
  {% for key, label, colour in series %}
    <span><i style="background:{{ colour }}"></i>{{ label }}</span>
  {% endfor %}
</div>
<h3>Cost for this folder</h3>
{{ folder_chart | safe }}
{% if annual_chart %}
<h3>Annual cost at {{ "{:,}".format(report.run.monthly_volume) }} documents a month</h3>
{{ annual_chart | safe }}
{% endif %}

<h3>The same numbers</h3>
<div class="scroll"><table>
  <thead><tr><th>Model</th><th>Architecture</th><th class="n">Per document</th>
    <th class="n">This folder</th>{% if report.run.monthly_volume %}<th class="n">Annual</th>{% endif %}
    <th class="n">Reach</th><th>Note</th></tr></thead>
  <tbody>
  {% for c in comparisons %}{% for a in c.architectures %}
    <tr>
      <td>{% if loop.first %}{{ c.display_name }}{% endif %}</td>
      <td>{{ a.label }}</td>
      <td class="n">{{ money(a.per_document_usd) if a.per_document_usd is not none else "n/a" }}</td>
      <td class="n">{{ money(a.folder_usd) if a.folder_usd is not none else "n/a" }}</td>
      {% if report.run.monthly_volume %}
      <td class="n">{{ money(a.annual_usd) if a.annual_usd is not none else "n/a" }}</td>{% endif %}
      <td class="n">{{ a.documents_served }}/{{ a.documents_total }}</td>
      <td class="why">{{ a.note }}</td>
    </tr>
  {% endfor %}{% endfor %}
  </tbody>
</table></div>
{% if report.cost and report.cost.volume %}
<p class="note">{{ report.cost.volume.basis }}</p>
{% endif %}
<p class="note">Input tokens only. What you pay for output depends on what you ask the model
to produce, which this tool cannot know.</p>

<h3>Per document</h3>
<div class="scroll"><table data-paginate="20">
  <thead><tr><th>Document</th><th class="n">Pages</th>
    {% for c in comparisons %}<th class="n">{{ c.display_name }}, text</th>
    <th class="n">{{ c.display_name }}, vision</th>{% endfor %}</tr></thead>
  <tbody>
  {% for doc in report.documents %}{% if doc.cost %}
    <tr><td class="mono">{{ doc.relative_path }}</td><td class="n">{{ doc.page_count }}</td>
      {% for m in doc.cost.models %}
        <td class="n">{{ money(m.text_path_input_usd) if m.text_path_input_usd is not none else "n/a" }}</td>
        <td class="n">{{ money(m.vision_input_usd_by_resolution.get(report.cost.headline_resolution)) if m.vision_input_usd_by_resolution.get(report.cost.headline_resolution) is not none else "n/a" }}</td>
      {% endfor %}
    </tr>
  {% endif %}{% endfor %}
  </tbody>
</table></div>
{% else %}
<p class="note">Cost was not part of this run.</p>
{% endif %}
</section>

{# =========================================================== SECURITY #}
<section data-page id="security" hidden>
<h2>Sensitive information</h2>
{% if "sensitive" not in report.run.components_run %}
<p class="note">The sensitive data scan was not part of this run.</p>
{% else %}
<p class="note">Values are masked. At most the last
{{ report.config_masking.reveal_tail_chars }} characters of any identifier appear here{% if report.config_masking.never_reveal %};
{{ report.config_masking.never_reveal | join(" and ") }} are never shown in full, even with
<code>--reveal</code>{% endif %}.</p>

{% if agg.sensitive_by_category %}
<h3>By category</h3>
<div class="scroll"><table>
  <thead><tr><th>Category</th><th>Severity</th><th class="n">Count</th><th>Note</th></tr></thead>
  <tbody>
  {% for cat, count in agg.sensitive_by_category | dictsort(by='value', reverse=true) %}
    {% set m = category_meta(cat) %}
    <tr><td>{{ m.label }}</td><td>{{ severity_badge(m.severity) | safe }}</td>
        <td class="n">{{ count }}</td><td class="why">{{ m.note }}</td></tr>
  {% endfor %}
  </tbody>
</table></div>

<h3>Every occurrence</h3>
{% set rows = [] %}
{% for doc in report.documents %}{% if doc.sensitive %}{% for m in doc.sensitive.matches %}
  {% set _ = rows.append((doc, m)) %}
{% endfor %}{% endif %}{% endfor %}
{{ matches_table(rows, true) }}
{% else %}
<p class="note">Nothing detected in the text that could be read. Check the limitations on
the summary page before reading that as an all-clear.</p>
{% endif %}

{% if agg.categories_not_scanned %}
<h3>Categories not scanned</h3>
<div class="scroll"><table>
  <thead><tr><th>Category</th><th>Why not</th></tr></thead>
  <tbody>{% for cat, reason in agg.categories_not_scanned | dictsort %}
    <tr><td>{{ category_meta(cat).label }}</td><td class="why">{{ reason }}</td></tr>
  {% endfor %}</tbody>
</table></div>
<p class="note">A category that was not scanned has a count of zero because nothing looked
for it, not because nothing is there.</p>
{% endif %}
{% endif %}
</section>

{# ========================================================== DOCUMENTS #}
<section data-page id="documents" hidden>
<h2>Documents</h2>
{% if agg.signal_distribution %}
<h3>Difficulty signals across the folder</h3>
<div class="scroll"><table>
  <thead><tr><th>Signal</th>{% if report.signal_weights %}<th class="n">Weight</th>{% endif %}
    <th class="n">Good</th><th class="n">Fair</th><th class="n">Poor</th><th class="n">N/A</th></tr></thead>
  <tbody>
  {% for sid, d in agg.signal_distribution | dictsort %}
    <tr><td>{{ signal_name(sid) }}</td>
      {% if report.signal_weights %}<td class="n">{{ "%.2f"|format(report.signal_weights.get(sid, 0)) }}</td>{% endif %}
      <td class="n">{% if d.good %}<span style="color:var(--good)">{{ d.good }}</span>{% endif %}</td>
      <td class="n">{% if d.fair %}<span style="color:var(--fair)">{{ d.fair }}</span>{% endif %}</td>
      <td class="n">{% if d.poor %}<span class="poor">{{ d.poor }}</span>{% endif %}</td>
      <td class="n">{% if d.not_applicable %}<span style="color:var(--na)">{{ d.not_applicable }}</span>{% endif %}</td></tr>
  {% endfor %}
  </tbody>
</table></div>
{% if report.signal_weights %}
<p class="note">Weights come from <code>difficulty.yaml</code>. A score is only produced when
every weight behind it is shown.</p>
{% endif %}
{% endif %}

<h3>Each document</h3>
<div id="docs">
{% for doc in report.documents %}
<details>
  <summary>{{ doc.relative_path }}
    <span>— {{ doc.format }}, {{ doc.page_count }} page(s){% if not doc.page_count_known %} (not fixed){% endif %}{% if doc.difficulty and doc.difficulty.score %}, difficulty <span class="r r-{{ score_band(doc.difficulty.score.value) }}">{{ doc.difficulty.score.value }}/100 {{ doc.difficulty.score.label }}</span>{% endif %}{% if doc.sensitive and doc.sensitive.total %}, {{ doc.sensitive.total }} sensitive item(s){% endif %}</span>
  </summary>
  <div>

  {% if doc.load_warnings %}
    <div class="warn"><strong>Reading this document was incomplete.</strong>
      <ul>{% for w in doc.load_warnings %}<li>{{ w }}</li>{% endfor %}</ul></div>
  {% endif %}

  {% if doc.previews %}
    <h4 class="sec sec-text"><span class="tag">what exists</span>Pages</h4>
    <div class="key">
      <span><i class="sw" style="background:#dcdcdc;border-color:#cfcfcf"></i> text</span>
      <span><i class="sw" style="background:#f4dfae;border-color:#dcbf7d"></i> image, needs OCR or vision</span>
      <span><i class="sw" style="background:#fff;border-color:var(--poor)"></i> sensitive, high severity</span>
      <span><i class="sw" style="background:#fff;border-color:var(--fair)"></i> sensitive, other</span>
    </div>
    <div class="pages">
    {% for pv in doc.previews[:max_preview_pages] %}
      <div class="page">
        <div class="pair">
          {% if pv.image_data_uri %}
          <div class="half"><div class="lbl">document</div>
            <img class="pg" src="{{ pv.image_data_uri }}" alt="Page {{ pv.number }}" loading="lazy"></div>
          {% endif %}
          <div class="half"><div class="lbl">{{ "extracted" if pv.image_data_uri else "layout" }}</div>
            {{ page_preview_svg(pv) | safe }}</div>
        </div>
        <div class="cap">p{{ pv.number }}{% if pv.rotation %} · {{ pv.rotation }}°{% endif %} ·
          {{ pv.image_coverage_pct | round | int }}% img{% if pv.sensitive_count %} ·
          {{ pv.sensitive_count }} sensitive{% endif %}</div>
      </div>
    {% endfor %}
    </div>
    {% if doc.previews | length > max_preview_pages %}
      <p class="note">Showing the first {{ max_preview_pages }} of {{ doc.previews | length }} pages.</p>
    {% endif %}
    {% if not doc.previews[0].image_data_uri %}
      <p class="note">Layout only. Run with <code>--page-images</code> to show the pages themselves.</p>
    {% endif %}
  {% endif %}

  {% if doc.difficulty %}
    {% set hard = hard_drivers(doc.difficulty) %}
    {% set easy = easy_drivers(doc.difficulty) %}
    <h4 class="sec sec-diff"><span class="tag">difficulty</span>How hard it is to extract{% if doc.difficulty.score %} —
      <span class="r r-{{ score_band(doc.difficulty.score.value) }}">{{ doc.difficulty.score.label }},
      {{ doc.difficulty.score.value }}/100</span>{% endif %}</h4>
    <div class="drivers">
      <div class="driver"><div class="lbl">makes it harder</div>
        {% if hard %}<table class="bare"><tbody>
        {% for s in hard %}
          <tr class="d-head"><td>{{ s.name }}</td><td class="v">{{ s.display }}</td>
              <td class="n"><span class="wt">{{ "%.2f"|format(s.weight) }}</span></td></tr>
          <tr class="d-why"><td colspan="3" class="why">{{ s.why }}</td></tr>
        {% endfor %}</tbody></table>{% else %}<p class="note">Nothing rated poor.</p>{% endif %}
      </div>
      <div class="driver"><div class="lbl">makes it easier</div>
        {% if easy %}<table class="bare"><tbody>
        {% for s in easy %}
          <tr class="d-head"><td>{{ s.name }}</td><td class="v">{{ s.display }}</td>
              <td class="n"><span class="wt">{{ "%.2f"|format(s.weight) }}</span></td></tr>
          <tr class="d-why"><td colspan="3" class="why">{{ s.why }}</td></tr>
        {% endfor %}</tbody></table>{% else %}<p class="note">Nothing rated good.</p>{% endif %}
      </div>
    </div>
    {% if doc.difficulty.score and doc.difficulty.score.confidence_note %}
      <p class="note">{{ doc.difficulty.score.confidence_note }}</p>
    {% endif %}
  {% endif %}

  {% if doc.extracted_text %}
    <h4 class="sec sec-text"><span class="tag">what was read</span>Extracted text</h4>
    <p class="note">This is what the cost, difficulty and sensitive-data numbers were computed
    from, so it is where to check whether a low score is the document's fault or the
    extractor's.</p>
    {% for pt in doc.extracted_text %}
      <details class="text">
        <summary>Page {{ pt.number }} — {{ "{:,}".format(pt.characters) }} characters,
          read as {{ pt.source }}{% if pt.truncated %}, truncated{% endif %}</summary>
        <div class="pair-text">
          <div class="half-text">
            <div class="lbl">{{ "text layer" if pt.source == "native" else pt.source }}</div>
            {% if pt.text.strip() %}<pre>{{ pt.text }}</pre>
            {% else %}<p class="note">Nothing was read from this page.</p>{% endif %}
          </div>
          {% if pt.ocr_text and pt.source == "native" %}
          <div class="half-text">
            <div class="lbl">what OCR sees</div>
            <pre>{{ pt.ocr_text }}</pre>
          </div>
          {% endif %}
        </div>
      </details>
    {% endfor %}
    {% if not report.run.ocr_compare_used %}
      <p class="note">OCR only ran where there was no text layer. Add <code>--ocr-compare</code>
      to read every page with OCR as well and see the two side by side.</p>
    {% endif %}
  {% endif %}

  {% if doc.sensitive and doc.sensitive.matches %}
    <h4 class="sec sec-pii"><span class="tag">security</span>Sensitive information —
      {{ doc.sensitive.total }} item(s)</h4>
    {% set rows = [] %}{% for m in doc.sensitive.matches %}{% set _ = rows.append((doc, m)) %}{% endfor %}
    {{ matches_table(rows, false) }}
  {% endif %}
  {% if doc.sensitive and doc.sensitive.unreadable_pages %}
    <p class="note"><strong>Page(s) {{ doc.sensitive.unreadable_pages | join(", ") }} carried no
    readable text and were not searched.</strong></p>
  {% endif %}

  <details class="more">
    <summary>All signals, page detail and provenance</summary>
    <div>
    {% if doc.difficulty %}
      <div class="scroll"><table>
        <thead><tr><th>Signal</th><th>Measured</th><th>Rating</th>
          {% if report.signal_weights %}<th class="n">Weight</th>{% endif %}<th>Why it matters</th></tr></thead>
        <tbody>
        {% for s in doc.difficulty.signals %}
          <tr><td>{{ s.name }}</td>
            <td>{{ s.display }}{% if s.reason %}<div class="why">{{ s.reason }}</div>{% endif %}</td>
            <td>{% if s.rating %}<span class="r r-{{ s.rating }}">{{ s.rating }}</span>{% else %}<span class="r r-na">{{ s.status.replace("_", " ") }}</span>{% endif %}</td>
            {% if report.signal_weights %}<td class="n">{{ "%.2f"|format(s.weight) }}</td>{% endif %}
            <td class="why">{{ s.why }}</td></tr>
        {% endfor %}
        </tbody>
      </table></div>
    {% endif %}
    {% if doc.cost %}
      <div class="scroll"><table data-paginate="15">
        <thead><tr><th class="n">Page</th><th>Size</th><th class="n">Scan DPI</th><th>Text</th>
          <th class="n">Text coverage</th></tr></thead>
        <tbody>{% for p in doc.cost.pages %}
          <tr><td class="n">{{ p.number }}</td><td>{{ p.size_label }}</td>
            <td class="n">{{ p.dpi if p.dpi else "—" }}</td><td>{{ p.text_source }}</td>
            <td class="n">{{ "%.1f"|format(p.text_coverage_pct) }}%</td></tr>
        {% endfor %}</tbody>
      </table></div>
    {% endif %}
    <p class="note">SHA-256 <code>{{ doc.sha256 }}</code></p>
    </div>
  </details>

  </div>
</details>
{% else %}
<p class="note">No documents were audited.</p>
{% endfor %}
</div>
</section>

</main>

<footer>
complydoc {{ report.run.tool_version }} · schema v{{ report.run.schema_version }} ·
config {{ report.run.config_digest }} · Python {{ report.run.python_version }} ·
{{ "%.1f"|format(report.run.duration_seconds) }}s ·
OCR {{ "on" if report.run.ocr_available and report.run.ocr_requested else "off" }} ·
name detection {{ "on" if report.run.ner_available else "off" }}
</footer>

<script>
/* Progressive enhancement only: with scripting off, every document and every
   table row is already on the page. This adds a filter and pagination for runs
   large enough that scrolling stops working. */
(function () {
  "use strict";

  function makeFilter(container) {
    var items = Array.prototype.slice.call(container.children).filter(function (el) {
      return el.tagName === "DETAILS";
    });
    if (items.length < 5) return;

    var bar = document.createElement("div");
    bar.className = "filter";
    var input = document.createElement("input");
    input.type = "search";
    input.placeholder = "Filter documents — filename, category, any text";
    input.setAttribute("aria-label", "Filter documents");
    var count = document.createElement("span");
    count.className = "count";
    bar.appendChild(input);
    bar.appendChild(count);
    container.parentNode.insertBefore(bar, container);

    var haystacks = items.map(function (el) { return el.textContent.toLowerCase(); });

    function apply() {
      var q = input.value.trim().toLowerCase();
      var shown = 0;
      items.forEach(function (el, i) {
        var hit = !q || haystacks[i].indexOf(q) !== -1;
        el.hidden = !hit;
        if (hit) shown++;
      });
      count.textContent = q
        ? shown + " of " + items.length + " document(s)"
        : items.length + " document(s)";
    }
    input.addEventListener("input", apply);
    apply();
  }

  function paginate(table) {
    var size = parseInt(table.getAttribute("data-paginate"), 10);
    var body = table.tBodies[0];
    if (!body || !size) return;
    var rows = Array.prototype.slice.call(body.rows);
    if (rows.length <= size) return;

    var page = 0;
    var pages = Math.ceil(rows.length / size);

    var bar = document.createElement("div");
    bar.className = "pager";
    var prev = document.createElement("button");
    prev.type = "button";
    prev.textContent = "Previous";
    var next = document.createElement("button");
    next.type = "button";
    next.textContent = "Next";
    var label = document.createElement("span");
    bar.appendChild(prev);
    bar.appendChild(next);
    bar.appendChild(label);
    var host = table.parentNode;
    host.parentNode.insertBefore(bar, host.nextSibling);

    function draw() {
      var first = page * size;
      var last = Math.min(first + size, rows.length);
      rows.forEach(function (row, i) { row.hidden = i < first || i >= last; });
      label.textContent = "Showing " + (first + 1) + "\u2013" + last + " of " + rows.length;
      prev.disabled = page === 0;
      next.disabled = page >= pages - 1;
    }
    prev.addEventListener("click", function () { if (page > 0) { page--; draw(); } });
    next.addEventListener("click", function () { if (page < pages - 1) { page++; draw(); } });
    draw();
  }


  function tabs() {
    var nav = document.getElementById("tabs");
    if (!nav) return;
    var links = Array.prototype.slice.call(nav.querySelectorAll("a"));
    var pages = Array.prototype.slice.call(document.querySelectorAll("section[data-page]"));

    function show(id) {
      var known = pages.some(function (p) { return p.id === id; });
      if (!known) id = pages[0].id;
      pages.forEach(function (p) { p.hidden = p.id !== id; });
      links.forEach(function (a) {
        if (a.getAttribute("data-tab") === id) a.setAttribute("aria-current", "page");
        else a.removeAttribute("aria-current");
      });
      window.scrollTo(0, 0);
    }
    // The click is the mechanism; the hash is a convenience on top of it. Some
    // viewers — a data: URL, a sandboxed mail preview — never report a hash, and
    // relying on it there would leave every tab dead but the first.
    links.forEach(function (a) {
      a.addEventListener("click", function (event) {
        event.preventDefault();
        var id = a.getAttribute("data-tab");
        show(id);
        try {
          history.replaceState(null, "", "#" + id);
        } catch (err) {
          /* file:// and data: URLs may refuse; the view has already switched. */
        }
      });
    });
    window.addEventListener("hashchange", function () {
      show(location.hash.replace("#", ""));
    });
    show(location.hash.replace("#", "") || pages[0].id);
  }

  function paginateList(host) {
    var size = parseInt(host.getAttribute("data-paginate-list"), 10);
    var items = Array.prototype.slice.call(host.children);
    if (!size || items.length <= size) return;
    var page = 0, count = Math.ceil(items.length / size);
    var bar = document.createElement("div");
    bar.className = "pager";
    var prev = document.createElement("button"); prev.type = "button"; prev.textContent = "Previous";
    var next = document.createElement("button"); next.type = "button"; next.textContent = "Next";
    var label = document.createElement("span");
    bar.appendChild(prev); bar.appendChild(next); bar.appendChild(label);
    host.parentNode.insertBefore(bar, host.nextSibling);
    function draw() {
      var first = page * size, last = Math.min(first + size, items.length);
      items.forEach(function (el, i) { el.hidden = i < first || i >= last; });
      label.textContent = "Showing " + (first + 1) + "\u2013" + last + " of " + items.length;
      prev.disabled = page === 0; next.disabled = page >= count - 1;
    }
    prev.addEventListener("click", function () { if (page > 0) { page--; draw(); } });
    next.addEventListener("click", function () { if (page < count - 1) { page++; draw(); } });
    draw();
  }

  tabs();
  Array.prototype.forEach.call(
    document.querySelectorAll("[data-paginate-list]"), paginateList
  );
  var docs = document.getElementById("docs");
  if (docs) makeFilter(docs);
  Array.prototype.forEach.call(
    document.querySelectorAll("table[data-paginate]"), paginate
  );
})();
</script>
</body>
</html>
