<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>complydoc — {{ report.run.target }}</title>
<link rel="icon" href="{{ favicon_uri }}">
<style>
  html { -webkit-text-size-adjust: 100%; }
  :root {
    color-scheme: light;
    --paper: #fbfbfa; --panel: #fff; --ink: #111; --ink-2: #333;
    --muted: #666; --faint: #999; --line: #e8e8e6; --line-2: #d8d8d4;
    --accent: #1a7f4b;
    --attn: #a4402f;
    --good: #6b7280; --fair: #55606d; --poor: #a4402f;
    --na: #8b939c; --na-bg: #f1f1ef;
    --add-bg: #dff0e2; --gone-bg: #f3e2de;
    --series-1: #2a78d6; --series-2: #4a3aa7; --series-3: #e87ba4;
    --pv-page: #fff; --pv-edge: #bbb; --pv-text: #dcdcdc;
    --pv-image: #f4dfae; --pv-gutter: #f4f4f2;
  }
  /* Dark is selected, not flipped: the chart steps were validated against the dark
     surface on their own, and the middle series changes hue because violet and blue
     are indistinguishable to a protanope there. */
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      color-scheme: dark;
      --paper: #16181a; --panel: #1d2023; --ink: #e9e9e7; --ink-2: #c9c9c6;
      --muted: #9aa0a6; --faint: #71767b; --line: #2b2f33; --line-2: #3a3f45;
      --accent: #4cc38a;
      --attn: #e08a72;
      --good: #8b939c; --fair: #a7b0b8; --poor: #e08a72;
      --na: #7d858d; --na-bg: #23272b;
      --add-bg: #1e3a2a; --gone-bg: #3a2622;
      --series-1: #3987e5; --series-2: #d55181; --series-3: #c98500;
      --pv-page: #24282c; --pv-edge: #4a5058; --pv-text: #4d545c;
      --pv-image: #6d5a2f; --pv-gutter: #1f2225;
    }
  }
  :root[data-theme="dark"] {
    color-scheme: dark;
    --paper: #16181a; --panel: #1d2023; --ink: #e9e9e7; --ink-2: #c9c9c6;
    --muted: #9aa0a6; --faint: #71767b; --line: #2b2f33; --line-2: #3a3f45;
    --accent: #4cc38a;
    --attn: #e08a72;
    --good: #8b939c; --fair: #a7b0b8; --poor: #e08a72;
    --na: #7d858d; --na-bg: #23272b;
    --add-bg: #1e3a2a; --gone-bg: #3a2622;
    --series-1: #3987e5; --series-2: #d55181; --series-3: #c98500;
    --pv-page: #24282c; --pv-edge: #4a5058; --pv-text: #4d545c;
    --pv-image: #6d5a2f; --pv-gutter: #1f2225;
  }
  body {
    margin: 0 auto; padding: 2.5rem 1.5rem 6rem; max-width: 84rem;
    background: var(--paper); color: var(--ink);
    font: 15px/1.5 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
    font-variant-numeric: tabular-nums;
  }
  .logo { display: block; margin: 0 0 1.25rem -4px; }
  .head { border-bottom: 2px solid var(--accent); padding-bottom: 0.875rem; margin-bottom: 0.5rem; }
  h1 { font-size: 1.375rem; font-weight: 600; margin: 0; }
  h1 .of { color: var(--muted); font-weight: 400; }
  h1 .of::before { content: " \2014 "; color: var(--faint); }
  h2 { font-size: 1rem; font-weight: 600; margin: 2.75rem 0 0.75rem;
       padding-top: 0.75rem; border-top: 1px solid var(--line-2); }
  h3 { font-size: 0.9375rem; font-weight: 600; margin: 1.75rem 0 0.5rem; }
  h4 { font-size: 0.8125rem; font-weight: 600; margin: 1.5rem 0 0.375rem; color: var(--ink-2); }
  p  { margin: 0 0 0.75rem; }
  .meta { color: var(--muted); font-size: 0.8125rem; margin: 0; }
  .note { color: var(--muted); font-size: 0.8125rem; max-width: 46rem; }
  code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 0.875em; }

  table { border-collapse: collapse; width: 100%; margin: 0.5rem 0 1rem; font-size: 0.875rem; }
  th, td { text-align: left; padding: 0.375rem 0.75rem 0.375rem 0; vertical-align: top;
           border-bottom: 1px solid var(--line); }
  th { font-weight: 600; border-bottom: 1px solid var(--line-2); white-space: nowrap; }
  td.n, th.n { text-align: right; white-space: nowrap; padding-right: 1.25rem; }
  .scroll { overflow-x: auto; }
  /* Ratings and severities are the two things a reader scans for, so they get
     the colour. Everything else stays monochrome. */
  /* Colour marks the exception. A rating that needs nothing from the reader is
     set in a lighter ink; only the ones that do are coloured. */
  .r { font-size: 0.8125rem; white-space: nowrap; }
  .r-good { color: var(--good); }
  .r-fair { color: var(--fair); }
  .r-poor { color: var(--attn); font-weight: 600; }
  .r-na   { color: var(--na); }
  .poor { color: var(--attn); font-weight: 600; }
  .fair { color: var(--fair); }
  .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; white-space: nowrap; }
  .why { color: var(--muted); font-size: 0.8125rem; }

  .box { border: 1px solid var(--line-2); border-left: 3px solid var(--accent);
         background: var(--panel); padding: 0.75rem 1rem; margin: 1rem 0; font-size: 0.875rem; }
  .box p:last-child { margin-bottom: 0; }
  .box strong { display: block; }

  details { margin: 0; border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; padding: 0.625rem 0; font-weight: 600; font-size: 0.9375rem; }
  summary span { font-weight: 400; color: var(--muted); font-size: 0.8125rem; }
  details > div { padding: 0 0 1.5rem; }

  ul { margin: 0.25rem 0 0.75rem; padding-left: 1.125rem; }
  li { margin-bottom: 0.25rem; }
  .lim { margin: 0 0 1.125rem; max-width: 46rem; padding-left: 0.75rem;
         border-left: 3px solid var(--line); }
  .lim.important { border-left-color: var(--fair); }
  .lim .h { font-weight: 600; font-size: 0.8125rem; }
  .ok { color: var(--accent); }
  .lim .files { color: var(--muted); font-size: 0.75rem; margin-top: 0.25rem;
                font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
                word-break: break-all; }
  /* --- the page viewer: one page, the page beside what was read off it -- */
  /* One segmented control: step, jump, step. Everything in it is the same
     height and shares one border, so it reads as a single thing rather than
     three controls that happen to sit near each other. */
  .pagebar { display: flex; align-items: center; gap: 0.75rem; margin: 0 0 0.875rem;
             font-size: 0.8125rem; color: var(--muted); }
  .pnav { display: inline-flex; align-items: stretch; border: 1px solid var(--line-2);
          border-radius: 4px; overflow: hidden; background: var(--panel); height: 1.875rem; }
  .pnav > * { border: none; background: none; }
  .pstep { font: inherit; font-size: 1rem; line-height: 1; width: 2rem; color: var(--muted);
           cursor: pointer; display: flex; align-items: center; justify-content: center; }
  .pstep:hover:not(:disabled) { background: var(--na-bg); color: var(--ink); }
  .pstep:disabled { color: var(--faint); cursor: default; }
  /* The counter is one centred segment between the arrows. Sizing the input to
     a fixed width and right-aligning it left a hole on its left instead. */
  .pmid { display: flex; align-items: center; justify-content: center; gap: 0.25rem;
          min-width: 5rem; padding: 0 0.5rem; font-variant-numeric: tabular-nums;
          border-left: 1px solid var(--line-2); border-right: 1px solid var(--line-2); }
  .pjump { font: inherit; font-size: 0.8125rem; width: 2.25rem; text-align: right;
           color: var(--ink); padding: 0;
           -moz-appearance: textfield; appearance: textfield; }
  .pjump::-webkit-outer-spin-button, .pjump::-webkit-inner-spin-button {
    -webkit-appearance: none; margin: 0; }
  .pjump:focus { outline: 2px solid var(--accent); outline-offset: 1px; border-radius: 2px; }
  .pof { color: var(--faint); }
  .pmiss { color: var(--attn); }
  /* Jumping between the pages where the readers parted company. On a long
     document those are a handful of pages among hundreds, and stepping through
     every page to find them is the whole difficulty. */
  .pdiff { font: inherit; font-size: 0.75rem; color: var(--muted); cursor: pointer;
           background: var(--panel); border: 1px solid var(--line-2); border-radius: 4px;
           height: 1.875rem; padding: 0 0.625rem; }
  .pdiff:hover { background: var(--na-bg); color: var(--ink); }
  .pdiff .dot { display: inline-block; width: 0.4375rem; height: 0.4375rem; border-radius: 50%;
                background: var(--attn); margin-right: 0.375rem; vertical-align: middle; }
  /* Two readings side by side, with the words that only one of them found.
     Underlines rather than colour alone: this is read on paper and in print,
     and the two marks must stay apart without it. */
  pre.dif mark { background: none; color: inherit; padding: 0; }
  pre.dif mark.added { background: var(--add-bg); text-decoration: underline;
                       text-decoration-thickness: 2px; text-underline-offset: 2px; }
  pre.dif mark.missing { background: var(--gone-bg); text-decoration: line-through;
                         text-decoration-thickness: 1px; color: var(--muted); }
  .pcap mark { padding: 0 0.25rem; border-radius: 2px; font-size: 0.6875rem; }
  .pcap mark.added { background: var(--add-bg); }
  .pcap mark.missing { background: var(--gone-bg); color: var(--muted); }
  /* One fixed frame, the same on every document and every page. Letting the
     page image set the height meant the whole workspace resized every time you
     stepped a page or picked another file. Content that does not fill it
     scrolls or sits inside it; nothing moves. */
  .spread { display: flex; gap: 1.25rem; align-items: stretch;
            --frame: clamp(26rem, 70vh, 54rem); }
  .spread[hidden] { display: none; }
  .spread .side { flex: 1 1 0; min-width: 0; display: flex; flex-direction: column; }
  /* A fixed label row, so the two frames start on the same line whether the
     label is a word or a pair of switch buttons. */
  .spread .side > .lbl { flex: 0 0 auto; display: flex; align-items: center; height: 1.625rem;
                         font-size: 0.625rem; color: var(--faint); text-transform: uppercase;
                         letter-spacing: 0.06em; margin-bottom: 0.375rem; }
  .spread .face { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column;
                  position: relative; }
  .spread .face[hidden] { display: none; }
  .spread .body { flex: 0 0 auto; height: var(--frame); overflow: auto;
                  background: var(--panel); border: 1px solid var(--line-2); }
  .spread .body > .note { margin: 0; padding: 0.75rem; }
  /* Reserved whether or not there is anything to say, so a page with no flags
     and a page with two does not shift what is underneath it. */
  .spread .pcap { flex: 0 0 auto; margin: 0.25rem 0 0; min-height: 1.5rem; }
  .swap { display: inline-flex; border: 1px solid var(--line-2); border-radius: 3px;
          overflow: hidden; }
  .swap button { font: inherit; font-size: 0.625rem; text-transform: uppercase;
                 letter-spacing: 0.06em; padding: 0.1875rem 0.5rem; border: none;
                 background: var(--panel); color: var(--faint); cursor: pointer; }
  .swap button + button { border-left: 1px solid var(--line-2); }
  .swap button[aria-selected="true"] { background: var(--na-bg); color: var(--ink); }
  .face[hidden] { display: none; }
  /* The page renders at the width of its half and scrolls if it is taller,
     rather than being shrunk until nothing on it can be read. */
  .pv, .pg { display: block; width: 100%; height: auto; background: var(--pv-page); }
  .spread pre { margin: 0; padding: 0.75rem; background: none; border: none;
                font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
                font-size: 0.75rem; line-height: 1.5; white-space: pre-wrap;
                word-break: break-word; }
  @media (max-width: 720px) { .spread { flex-direction: column; } }
  .key { display: flex; flex-wrap: wrap; gap: 0.875rem; font-size: 0.6875rem;
         color: var(--faint); margin: 0.375rem 0 0; align-items: center; }
  .key span { display: inline-flex; align-items: center; gap: 0.3125rem; }
  .sw { width: 11px; height: 11px; display: inline-block; border: 1px solid var(--line-2); }
  /* The marks carry their own explanation, so say they are worth pointing at. */
  /* The mark is an outline, and an SVG shape with no fill only answers the
     pointer along its stroke — on a mark six pixels tall that is two hairlines,
     which is why pointing at one did nothing. */
  .pv-mark { cursor: help; }
  .pv-mark rect { pointer-events: all; }
  .pv-mark:hover rect { stroke-width: 2.4; }
  /* The explanation follows the mark rather than sitting under the page. Under
     the page it was a line of text away from the thing it described, and it
     moved the caption every time the pointer crossed a mark. */
  .pv-tip { position: absolute; z-index: 5; max-width: 20rem; padding: 0.375rem 0.5rem;
            background: var(--panel); border: 1px solid var(--line-2); border-radius: 4px;
            font-size: 0.75rem; line-height: 1.4; color: var(--ink);
            pointer-events: none; }
  .pv-tip b { display: block; font-weight: 600; }
  .pv-tip .found { display: block; margin: 0.1875rem 0 0.25rem;
                   font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
                   font-size: 0.8125rem; letter-spacing: 0.02em; color: var(--ink); }
  .pv-tip .why { display: block; color: var(--muted); }
  .filter { display: flex; gap: 0.5rem; align-items: baseline; margin: 0 0 0.75rem; }
  .filter input { font: inherit; font-size: 0.875rem; padding: 0.3125rem 0.5rem;
                  border: 1px solid var(--line-2); background: var(--panel); color: inherit;
                  border-radius: 4px; width: 100%; min-width: 0; }
  .filter input:focus { outline: 2px solid var(--accent); outline-offset: -1px; }
  .filter .count { font-size: 0.8125rem; color: var(--muted); }
  th[data-sort] { cursor: pointer; user-select: none; white-space: nowrap; }
  th[data-sort]:hover { color: var(--ink); }
  th[data-sort]::after { content: "\2195"; color: var(--faint); margin-left: 0.3125rem;
                         font-size: 0.75em; }
  th[aria-sort="ascending"]::after { content: "\2191"; color: var(--ink); }
  th[aria-sort="descending"]::after { content: "\2193"; color: var(--ink); }
  .pager { display: flex; gap: 0.5rem; align-items: baseline; margin: -0.5rem 0 1rem;
           font-size: 0.8125rem; color: var(--muted); }
  .pager button { font: inherit; padding: 0.125rem 0.5rem; border: 1px solid var(--line-2);
                  background: var(--panel); color: inherit; cursor: pointer; }
  .pager button:disabled { color: var(--faint); cursor: default; }
  @media print { .filter, .pager { display: none; } }
  h4.sec { display: flex; align-items: baseline; gap: 0.5rem; font-size: 0.9375rem;
           color: var(--ink); margin: 1.75rem 0 0.5rem; padding-top: 0.75rem;
           border-top: 1px solid var(--line); }
  h4.sec .tag { font-size: 0.625rem; text-transform: uppercase; letter-spacing: 0.07em;
                font-weight: 600; padding: 0.125rem 0.375rem; border-radius: 2px; }
  /* The eyebrow names the subject; it is not a status, so it takes no colour. */
  h4.sec .tag { background: var(--na-bg); color: var(--na); }
  details.text { border-bottom: 1px solid var(--line); }
  details.text > summary { font-weight: 400; font-size: 0.8125rem; color: var(--muted);
                           padding: 0.375rem 0; }
  details.text pre { margin: 0 0 0.75rem; padding: 0.75rem; background: var(--panel);
                     border: 1px solid var(--line); max-height: 26rem; overflow: auto;
                     font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
                     font-size: 0.75rem; line-height: 1.45; white-space: pre-wrap;
                     word-break: break-word; }
  .tiles { display: flex; flex-wrap: wrap; gap: 1rem; margin: 1rem 0 1.75rem; }
  .tile { flex: 1 1 15rem; background: var(--panel); border: 1px solid var(--line);
          border-radius: 5px; padding: 0.875rem 1rem; }
  .tile .k { font-size: 0.75rem; color: var(--muted); }
  .tile .v { font-size: 1.875rem; font-weight: 600; letter-spacing: -0.02em;
             margin: 0.1875rem 0 0.25rem; }
  .tile .v .u { font-size: 0.9375rem; font-weight: 400; color: var(--faint); }
  .tile .s { font-size: 0.75rem; color: var(--muted); line-height: 1.4; }
  .topline { display: flex; align-items: center; justify-content: space-between;
             gap: 1rem; margin-bottom: 1.25rem; }
  .logo { display: block; margin: 0 0 0 -6px; }
  #theme { font: inherit; font-size: 0.75rem; padding: 0.25rem 0.625rem;
           border: 1px solid var(--line-2); background: var(--panel); color: var(--muted);
           cursor: pointer; border-radius: 3px; }
  #theme:hover { color: var(--ink); }

  /* --- documents explorer -------------------------------------------- */
  /* The list is centred on the panels, not on the column that holds them —
     the filename and the page bar sit above those, so centring on the column
     leaves the list riding high. Script sets the offset; without it the list
     starts at the top, which is correct if plainer. */
  .explorer { display: flex; gap: 1.5rem; align-items: flex-start; margin-top: 0.75rem; }
  .files { flex: 0 0 15rem; max-width: 15rem; }
  .files ul { list-style: none; margin: 0.5rem 0 0; padding: 0;
              border: 1px solid var(--line); border-radius: 4px; overflow: hidden;
              max-height: 34rem; overflow-y: auto; background: var(--panel); }
  .files li { border-bottom: 1px solid var(--line); }
  .files li:last-child { border-bottom: none; }
  .files button { display: flex; width: 100%; gap: 0.5rem; align-items: baseline;
                  text-align: left; font: inherit; font-size: 0.8125rem;
                  padding: 0.5rem 0.625rem; background: none; border: none;
                  color: inherit; cursor: pointer; }
  .files button:hover { background: var(--na-bg); }
  .files button[aria-current="true"] { background: var(--na-bg); font-weight: 600;
                                       box-shadow: inset 3px 0 0 var(--accent); }
  .files .nm { flex: 1 1 auto; min-width: 0; overflow: hidden; text-overflow: ellipsis;
               white-space: nowrap; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
  .files .sc { flex: 0 0 auto; font-size: 0.6875rem; }
  .viewer { flex: 1 1 0; min-width: 0; }
  .viewer > .doc[hidden] { display: none; }
  .docbar { display: flex; align-items: baseline; justify-content: space-between;
            gap: 1.5rem; border-bottom: 1px solid var(--line); margin-bottom: 0.875rem; }
  .doc h3 { margin: 0 0 0.5rem; font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
            font-size: 0.9375rem; }
  .doc-meta { font-size: 0.8125rem; color: var(--muted); margin: 0.25rem 0 0.375rem; }
  .doc-meta .attn { color: var(--attn); font-weight: 600; }
  .concerns { font-size: 0.8125rem; color: var(--attn); margin: 0 0 1.25rem;
              line-height: 1.6; max-width: 68ch; }
  .concerns span { cursor: help; border-bottom: 1px dotted currentColor; }
  .flag { font-size: 0.6875rem; color: var(--na); }
  .flag.bad { color: var(--attn); }
  .flag.warn { color: var(--fair); }
  .flag.ok { color: var(--good); }
  .subtabs { display: flex; gap: 0.25rem; margin: 0; }
  .subtabs button { font: inherit; font-size: 0.8125rem; font-weight: 600;
                    padding: 0.375rem 0.75rem; background: none; border: none;
                    border-bottom: 2px solid transparent; color: var(--muted);
                    cursor: pointer; margin-bottom: -1px; }
  .subtabs button[aria-selected="true"] { color: var(--ink); border-bottom-color: var(--accent); }
  .pcap { font-size: 0.6875rem; color: var(--na); margin-top: 0.25rem; line-height: 1.5; }
  @media (max-width: 860px) {
    .explorer { flex-direction: column; }
    .files { flex: 1 1 auto; max-width: none; width: 100%; margin-top: 0 !important; }
  }
  .drivers { display: flex; flex-wrap: wrap; gap: 2rem; margin: 0.25rem 0 1.25rem; }
  .driver { flex: 1 1 22rem; min-width: 0; }
  .driver > .lbl { font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.06em;
                   color: var(--faint); margin-bottom: 0.375rem;
                   border-bottom: 1px solid var(--line); padding-bottom: 0.25rem; }
  table.bare { margin: 0; table-layout: fixed; }
  table.bare td { border-bottom: none; padding: 0.25rem 0.5rem 0 0; }
  table.bare tr.d-head td { font-weight: 600; font-size: 0.8125rem; padding-top: 0.5rem; }
  table.bare tr.d-why td { padding: 0 0 0.5rem; border-bottom: 1px solid var(--line); }
  table.bare td.v { white-space: normal; font-weight: 400; color: var(--ink-2);
                    font-size: 0.8125rem; text-align: right; width: 42%; }
  table.bare td.n { width: 3rem; }
  .wt { font-size: 0.6875rem; color: var(--faint); }
  /* Named for what it is, not how it feels: ".warn" collided with the ".flag warn"
     level and gave every page caption a border and 14px of padding. */
  .notice { border: 1px solid var(--line-2); border-left: 3px solid var(--attn);
            background: var(--panel); padding: 0.625rem 0.875rem; margin: 0.75rem 0;
            font-size: 0.8125rem; }
  .notice ul { margin: 0.25rem 0 0; }
  details.more { border: none; margin: 0.5rem 0 0; }
  details.more > summary { font-weight: 400; font-size: 0.8125rem; color: var(--muted);
                           padding: 0.375rem 0; }
  details.more > summary::marker { color: var(--faint); }
  footer { margin-top: 4rem; padding-top: 1.5rem; border-top: 2px solid var(--accent); }
  .foot-main { display: flex; flex-wrap: wrap; gap: 2.5rem; align-items: flex-start; }
  .foot-main > div:first-child { flex: 1 1 18rem; }
  footer .logo { width: 170px; height: auto; margin: 0 0 0.5rem -5px; }
  .foot-claim { font-size: 0.8125rem; color: var(--muted); max-width: 32ch; margin: 0; }
  .foot-meta { flex: 1 1 22rem; display: grid; grid-template-columns: auto 1fr;
               gap: 0.25rem 1rem; margin: 0; font-size: 0.75rem; }
  .foot-meta dt { color: var(--faint); white-space: nowrap; }
  .foot-meta dd { margin: 0; color: var(--ink-2); overflow-wrap: anywhere; }
  .foot-rule { margin-top: 1.5rem; padding-top: 0.75rem; border-top: 1px solid var(--line);
               color: var(--faint); font-size: 0.6875rem; }
  @media print {
    body { padding: 0; max-width: none; font-size: 10.5pt; background: #fff; color: #000; }
    details > div { display: block !important; }
    summary { list-style: none; }
    h2 { break-after: avoid; }
    tr, .lim { break-inside: avoid; }
  }

  /* --- page chrome --------------------------------------------------- */
  nav.tabs { display: flex; gap: 0.25rem; margin: 1.25rem 0 0; border-bottom: 1px solid var(--line-2);
             flex-wrap: wrap; }
  nav.tabs a { padding: 0.5rem 0.875rem; font-size: 0.875rem; font-weight: 600;
               color: var(--muted); text-decoration: none; border: 1px solid transparent;
               border-bottom: none; margin-bottom: -1px; border-radius: 3px 3px 0 0; }
  nav.tabs a:hover { color: var(--ink); }
  nav.tabs a[aria-current="page"] { color: var(--ink); background: var(--paper);
                                    border-color: var(--line-2); }
  nav.tabs .n { font-weight: 400; color: var(--faint); margin-left: 0.3125rem; }
  section[data-page] > h2:first-child { border-top: none; padding-top: 0; }
  /* Two of the four pages open on a heading and two do not, so the spacing
     below the tab bar is set on whatever comes first. */
  section[data-page] > :first-child { margin-top: 2rem; }
  .legend { display: flex; flex-wrap: wrap; gap: 1rem; font-size: 0.75rem; color: var(--muted);
            margin: 0 0 0.5rem; }
  .legend span { display: inline-flex; align-items: center; gap: 0.375rem; }
  .legend i { width: 11px; height: 11px; border-radius: 2px; display: inline-block; }
  .legend .why { font-size: 0.6875rem; color: var(--faint); }
  .chart { display: block; max-width: 100%; margin: 0.25rem 0 1rem; }
  .chart .grp { transition: transform 0.26s cubic-bezier(0.4, 0, 0.2, 1),
                             opacity 0.16s ease; }
  .chart .grp.out { opacity: 0; pointer-events: none; }
  @media (prefers-reduced-motion: reduce) {
    .chart .grp { transition: none; }
  }
  .providers { display: flex; flex-wrap: wrap; gap: 0.375rem; margin: 0 0 1rem; }
  .providers button { font: inherit; font-size: 0.75rem; padding: 0.1875rem 0.625rem;
                      border: 1px solid var(--line-2); background: var(--panel);
                      color: var(--muted); border-radius: 3px; cursor: pointer; }
  .providers button:hover { color: var(--ink); }
  .providers button[aria-pressed="true"] { background: var(--accent); border-color: var(--accent);
                                           color: #fff; }
  .foot-meta dd.opts { font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
                       font-size: 0.6875rem; }
  .lims { max-height: none; }
  .pair-text { display: flex; gap: 0.75rem; }
  .pair-text .half-text { flex: 1 1 0; min-width: 0; }
  .pair-text .lbl { font-size: 0.625rem; color: var(--faint); text-transform: uppercase;
                    letter-spacing: 0.06em; margin: 0 0 0.25rem; }
  @media print { nav.tabs { display: none; } section[data-page] { display: block !important; } }
</style>
</head>
<body>

{% macro plural(n, word, suffix="s") %}{{ n }} {{ word }}{{ "" if n == 1 else suffix }}{% endmacro %}

{% macro matches_table(rows, show_doc) %}
{# Sorted most serious first, and re-sortable by any column: on a security page
   the question is almost always "what is the worst of it", not "what came
   first in the folder". #}
<div class="scroll"><table data-paginate="25" data-sortable>
  <thead><tr>
    {% if show_doc %}<th data-sort="text">Document</th>{% endif %}
    <th class="n" data-sort="num">Page</th><th class="n" data-sort="num">Line</th>
    <th data-sort="text">Category</th><th data-sort="num" data-sort-default="desc">Severity</th>
    <th>Value</th>{% if report.run.reveal_used %}<th>Revealed</th>{% endif %}<th>Matched because</th>
  </tr></thead>
  <tbody>
  {% for doc, m in rows %}
    <tr>
      {% if show_doc %}<td class="mono">{{ doc.relative_path }}</td>{% endif %}
      <td class="n">{{ m.page }}</td><td class="n">{{ m.line }}</td>
      <td>{{ m.label }}</td>
      <td data-value="{{ severity_rank(m.severity) }}">{{ severity_badge(m.severity) | safe }}</td>
      <td class="mono">{{ m.masked }}</td>
      {% if report.run.reveal_used %}<td class="mono">{{ m.revealed if m.revealed else "—" }}</td>{% endif %}
      <td class="why">
        {%- if m.validators_passed %}passed {{ m.validators_passed | join(", ") }}{% endif -%}
        {%- if m.context_term %}{% if m.validators_passed %}; {% endif %}near "{{ m.context_term }}"{% endif -%}
        {%- if not m.validators_passed and not m.context_term %}pattern match{% endif -%}
      </td>
    </tr>
  {% endfor %}
  </tbody>
</table></div>
{% endmacro %}

<div class="topline">
  {{ logo_svg | safe }}
  <button type="button" id="theme" hidden aria-pressed="false">Dark</button>
</div>
{# No page heading: the mark says what this is, and the folder, the timestamp
   and the version are provenance that belongs in the footer. #}

{% if report.run.reveal_used %}
<div class="box"><strong>This report contains unmasked sensitive values.</strong>
  <p>Generated with <code>--reveal</code>. Handle it with the same care as the documents it
  describes.</p></div>
{% endif %}

{% set agg = report.aggregate %}
<nav class="tabs" id="tabs">
  <a href="#summary" data-tab="summary">Summary</a>
  <a href="#cost" data-tab="cost">Cost</a>
  <a href="#security" data-tab="security">Security<span class="n">{{ agg.sensitive_total }}</span></a>
  <a href="#documents" data-tab="documents">Documents<span class="n">{{ agg.documents_audited }}</span></a>
</nav>
<main>

{# How many documents each architecture could actually be used on, said once
   per architecture rather than on all ninety bars. It has to be said: read on
   price alone the text layer always wins, and the reason it is cheapest is
   that it does not work on the scans. #}
{% macro legend() %}
<div class="legend">
  {% for key, label, colour in series %}
    {% set reached = headline.by_key(key) if headline else none %}
    <span><i style="background:{{ colour }}"></i>{{ label }}{% if reached
      %}<span class="why">{{ reached.documents_served }}/{{ reached.documents_total }}
      documents</span>{% endif %}</span>
  {% endfor %}
</div>
{% endmacro %}

{# ============================================================ SUMMARY #}
<section data-page id="summary">
<h2>What this folder looks like</h2>

{% set cheapest = comparisons | map(attribute="architectures") | map("first") | list %}
<div class="tiles">
  <div class="tile">
    <div class="k">Cost per 1,000 documents</div>
    {% if headline %}
      {% set best = headline %}
      {% set ocr = best.by_key("text_ocr") %}
      {% set vis = best.by_key("vision") %}
      <div class="v">{{ money(ocr.per_1000_usd) if ocr.per_1000_usd is not none else "—" }}</div>
      <div class="s">reading the text, on {{ best.display_name }}{% if
        vis.per_1000_usd is not none %} — up to {{ money(vis.per_1000_usd) }} sending every
        page as an image{% endif %}.</div>
    {% else %}<div class="v">—</div><div class="s">cost was not part of this run</div>{% endif %}
  </div>

  <div class="tile">
    <div class="k">AI readiness</div>
    {% if agg.mean_readiness_score is not none %}
      <div class="v">{{ agg.mean_readiness_score | round | int }}<span class="u">/100</span></div>
      {# "Higher is better" is what the name now says; it was there when this
         read "difficulty" and meant the opposite. #}
      <div class="s">
        {% set bands = agg.readiness_bands %}
        {{ bands.get("ready", 0) + bands.get("workable", 0) }} of
        {{ agg.documents_audited }} workable or better</div>
    {% else %}<div class="v">—</div><div class="s">readiness was not part of this run</div>{% endif %}
  </div>

  <div class="tile">
    <div class="k">Local preparation</div>
    {% if agg.hours_per_1000_documents is not none %}
      <div class="v">{{ duration(agg.hours_per_1000_documents * 3600) }}<span class="u"> / 1,000</span></div>
      {# The OCR rate and the caveat about what this excludes are both on the
         timing table, where someone reading about time will find them. #}
      <div class="s">on this machine, {{ duration(agg.seconds_per_document) }} a document</div>
    {% else %}<div class="v">—</div><div class="s">nothing was timed</div>{% endif %}
  </div>

  <div class="tile">
    <div class="k">Sensitive items per document</div>
    {% if "sensitive" in report.run.components_run %}
      <div class="v">{{ "%.1f"|format(agg.sensitive_total / agg.documents_audited) if agg.documents_audited else 0 }}</div>
      {% set high = agg.sensitive_by_severity.get("high", 0) %}
      <div class="s">{{ agg.sensitive_total }} in
        {{ agg.documents_with_sensitive_data }} of {{ agg.documents_audited }} documents,
        {{ high }} high severity</div>
    {% else %}<div class="v">—</div><div class="s">the sensitive scan was not part of this run</div>{% endif %}
  </div>
</div>

{% if per_1000_chart %}
{# The tile above already names this figure; a heading repeating it is a second
   label on one number. #}
{{ legend() }}
{{ per_1000_chart | safe }}
{% endif %}

{% if report.staleness_warnings %}
<div class="box"><strong>Unverified prices</strong>
  <ul>{% for w in report.staleness_warnings %}<li>{{ w }}</li>{% endfor %}</ul></div>
{% endif %}

<details class="more">
  <summary>Run detail — {{ plural(agg.documents_audited, "document") }},
    {{ plural(agg.pages_total, "page") }}{% if agg.documents_skipped %},
    {{ agg.documents_skipped }} skipped{% endif %}</summary>
  <div>
  <table><tbody>
    <tr><td>Documents audited</td><td class="n">{{ agg.documents_audited }}</td>
        <td class="why">{{ plural(agg.pages_total, "page") }}</td></tr>
    {% if agg.pages_unreadable %}
    <tr><td>Pages not read</td><td class="n">{{ agg.pages_unreadable }}</td>
        <td class="why">not searched for sensitive data</td></tr>{% endif %}
    <tr><td>Network guard</td>
        <td class="n">{% if report.run.offline_guard == "armed" %}<span class="ok">armed</span>{% else %}<span class="poor">{{ report.run.offline_guard }}</span>{% endif %}</td>
        <td class="why">no document content left this machine</td></tr>
  </tbody></table>
  {% if report.skipped %}
  <div class="scroll"><table data-paginate="15">
    <thead><tr><th>File not examined</th><th>Reason</th></tr></thead>
    <tbody>{% for sk in report.skipped %}
      <tr><td class="mono">{{ sk.path.name }}</td><td class="why">{{ sk.reason }}</td></tr>
    {% endfor %}</tbody>
  </table></div>
  {% endif %}
  </div>
</details>

{% if agg.projected_seconds %}
<h3>How long this takes</h3>
<p class="note">Measured on this machine, reading and analysing the documents. This is the
work before anything reaches a model; time on the model itself is not estimated unless a
throughput is configured for it.</p>
<div class="scroll"><table>
  <thead><tr><th>Stage</th><th class="n">This folder</th><th>What it covers</th></tr></thead>
  <tbody>
    <tr><td>Reading</td><td class="n">{{ duration(agg.read_seconds) }}</td>
      <td class="why">Opening each file and pulling out its text, words and geometry.</td></tr>
    {% if agg.ocr_seconds %}
    <tr><td>OCR</td><td class="n">{{ duration(agg.ocr_seconds) }}</td>
      <td class="why">Reading {{ plural(agg.ocr_pages, "page") }} that carried no text layer,
        at {{ agg.ocr_pages_per_second }} a second.</td></tr>
    {% endif %}
    <tr><td>Readiness signals</td><td class="n">{{ duration(agg.analyse_seconds) }}</td>
      <td class="why">Measuring the signals on every page.</td></tr>
    <tr><td>Identifier scan</td><td class="n">{{ duration(agg.scan_seconds) }}</td>
      <td class="why">Searching the text for personal and financial identifiers.</td></tr>
    <tr class="d-head"><td>Total</td><td class="n">{{ duration(agg.total_seconds) }}</td>
      <td class="why">{{ duration(agg.seconds_per_document) }} a document,
        {{ duration(agg.seconds_per_page) }} a page{% if report.run.jobs > 1 %}, measured
        across {{ report.run.jobs }} processes{% endif %}.</td></tr>
  </tbody>
</table></div>

<h4 class="sec">At other volumes <span class="tag">projected</span></h4>
<p class="note">The measured rate applied to a larger backlog — documents like these ones.
A folder of longer or heavier scans takes longer.</p>
<div class="scroll"><table>
  <thead><tr><th class="n">Documents</th><th class="n">Preparation time</th></tr></thead>
  <tbody>
  {% for size, seconds in agg.projected_seconds.items() %}
    <tr><td class="n">{{ "{:,}".format(size | int) }}</td>
      <td class="n">{{ duration(seconds) }}</td></tr>
  {% endfor %}
  {% if report.run.monthly_volume %}
    <tr class="d-head"><td class="n">{{ "{:,}".format(report.run.monthly_volume) }} a month</td>
      <td class="n">{{ duration(agg.seconds_per_document * report.run.monthly_volume) }}</td></tr>
  {% endif %}
  </tbody>
</table></div>
{% endif %}
</section>

{# =============================================================== COST #}
<section data-page id="cost" hidden>
{% if comparisons %}
{{ legend() }}
{% set providers = comparisons | map(attribute="provider") | unique | sort | list %}
{% if providers | length > 1 %}
<div class="providers" id="providers">
  <button type="button" data-provider="" aria-pressed="true">All providers</button>
  {% for provider in providers %}
    <button type="button" data-provider="{{ provider }}" aria-pressed="false">{{ provider }}</button>
  {% endfor %}
</div>
{% endif %}
<h3>Cost for this folder</h3>
{{ folder_chart | safe }}
{% if annual_chart %}
<h3>Annual cost at {{ "{:,}".format(report.run.monthly_volume) }} documents a month</h3>
{{ annual_chart | safe }}
{% endif %}

{% set batched = comparisons | selectattr("batch_per_1000_usd") | list %}
{% if batched %}
<h3>Through a batch endpoint</h3>
<p class="note">The same text tokens, sent to the provider's batch API instead of its
interactive one. Shown only for models that publish a batch price — a discount that is
customary but unpublished is not a number this report will put in a budget.</p>
<div class="scroll"><table data-sortable>
  <thead><tr><th data-sort="text">Model</th>
    <th class="n" data-sort="num">Interactive / 1,000</th>
    <th class="n" data-sort="num" data-sort-default="desc">Batch / 1,000</th>
    <th class="n" data-sort="num">Saving</th></tr></thead>
  <tbody>
  {% for c in batched %}
    {% set standard = c.by_key("text_ocr") %}
    {% if standard and standard.per_1000_usd %}
    <tr><td>{{ c.display_name }}</td>
      <td class="n">{{ money(standard.per_1000_usd) }}</td>
      <td class="n">{{ money(c.batch_per_1000_usd) }}</td>
      <td class="n" data-value="{{ (1 - c.batch_per_1000_usd / standard.per_1000_usd) * 100 }}">
        {{ "%.0f%%"|format((1 - c.batch_per_1000_usd / standard.per_1000_usd) * 100) }}</td></tr>
    {% endif %}
  {% endfor %}
  </tbody>
</table></div>
{% endif %}

<h3>Per document</h3>
{% set cheapest = headline or comparisons | last %}
<div class="scroll"><table data-paginate="20">
  <thead><tr><th>Document</th><th class="n">Pages</th>
    <th class="n">Text</th><th class="n">Vision</th></tr></thead>
  <tbody>
  {% for doc in report.documents %}{% if doc.cost %}
    {% set m = doc.cost.models | selectattr("model_id", "equalto", cheapest.model_id) | first %}
    <tr><td class="mono">{{ doc.relative_path }}</td><td class="n">{{ doc.page_count }}</td>
      <td class="n">{{ money(m.text_path_input_usd) if m and m.text_path_input_usd is not none else "n/a" }}</td>
      <td class="n">{{ money(m.vision_input_usd_by_resolution.get(report.cost.headline_resolution)) if m and m.vision_input_usd_by_resolution.get(report.cost.headline_resolution) is not none else "n/a" }}</td>
    </tr>
  {% endif %}{% endfor %}
  </tbody>
</table></div>
<p class="note">Priced on {{ cheapest.display_name }}. Multiply by the ratio in the chart
above for any other.</p>
{% else %}
<p class="note">Cost was not part of this run.</p>
{% endif %}
</section>

{# =========================================================== SECURITY #}
<section data-page id="security" hidden>
<h2>Sensitive information</h2>
{% if "sensitive" not in report.run.components_run %}
<p class="note">The sensitive data scan was not part of this run.</p>
{% else %}
<p class="note">Masked to the last {{ report.config_masking.reveal_tail_chars }} characters{% if report.config_masking.never_reveal %};
{{ report.config_masking.never_reveal | join(" and ") }} never shown in full{% endif %}.</p>
{# Saying "masked" and nothing else would be a half-truth in a report that also
   carries the pages these values were read off. #}
{% if report.run.extracted_text_used or report.run.page_images_used %}
<div class="notice"><strong>The masking applies to this table, not to the whole file.</strong>
  <p>This report also carries
  {%- if report.run.extracted_text_used %} the text read off each page{% endif %}
  {%- if report.run.extracted_text_used and report.run.page_images_used %} and{% endif %}
  {%- if report.run.page_images_used %} a picture of each page{% endif %}, on the Documents
  page, where these values appear as they do in the document. Treat the file as you would
  treat the documents themselves. Run with
  {%- if report.run.extracted_text_used %} <code>--no-extracted-text</code>{% endif %}
  {%- if report.run.extracted_text_used and report.run.page_images_used %} and{% endif %}
  {%- if report.run.page_images_used %} without <code>--page-images</code>{% endif %}
  for a report that carries no document content.</p></div>
{% endif %}

{% if agg.sensitive_by_category %}
<h3>By category</h3>
<div class="scroll"><table data-sortable>
  <thead><tr><th data-sort="text">Category</th><th data-sort="text">Region</th>
    <th data-sort="num">Severity</th><th class="n" data-sort="num" data-sort-default="desc">Count</th>
    <th>Note</th></tr></thead>
  <tbody>
  {% for cat, count in agg.sensitive_by_category | dictsort(by='value', reverse=true) %}
    {% set m = category_meta(cat) %}
    <tr><td>{{ m.label }}</td><td><span class="flag">{{ m.region }}</span></td>
        <td data-value="{{ severity_rank(m.severity) }}">{{ severity_badge(m.severity) | safe }}</td>
        <td class="n">{{ count }}</td><td class="why">{{ m.note }}</td></tr>
  {% endfor %}
  </tbody>
</table></div>

<h3>Every occurrence</h3>
{{ matches_table(sensitive_rows(report), true) }}
{% else %}
<p class="note">Nothing detected in the text that could be read. Check the limitations
before reading that as an all-clear.</p>
{% endif %}

{% if agg.categories_not_scanned %}
<h3>Categories not scanned</h3>
<div class="scroll"><table>
  <thead><tr><th>Category</th><th>Why not</th></tr></thead>
  <tbody>{% for cat, reason in agg.categories_not_scanned | dictsort %}
    <tr><td>{{ category_meta(cat).label }}</td><td class="why">{{ reason }}</td></tr>
  {% endfor %}</tbody>
</table></div>
<p class="note">These count zero because nothing looked, not because nothing is there.</p>
{% endif %}
{% endif %}
</section>

{# ========================================================== DOCUMENTS #}
<section data-page id="documents" hidden>

<div class="explorer" id="explorer">
  <aside class="files">
    <div class="filter">
      <input type="search" id="docfilter" placeholder="Filter files" aria-label="Filter files">
    </div>
    <div class="count" id="doccount"></div>
    <ul id="filelist">
    {% for doc in report.documents %}
      {%- set poor = doc.readiness.signals | selectattr("rating", "equalto", "poor") | list if doc.readiness else [] -%}
      {%- set sources = doc.extracted_text | map(attribute="source") | list -%}
      {%- set haystack = [doc.relative_path, doc.format]
            + (poor | map(attribute="name") | list)
            + sources
            + ([doc.readiness.score.label] if doc.readiness and doc.readiness.score else []) -%}
      <li data-search="{{ haystack | join(' ') | lower }}">
        <button type="button" data-doc="{{ loop.index0 }}">
          <span class="nm">{{ doc.relative_path }}</span>
          {% if doc.readiness and doc.readiness.score %}
            <span class="sc r r-{{ score_band(doc.readiness.score.value) }}">{{ doc.readiness.score.value | round | int }}</span>
          {% else %}<span class="sc r r-na">—</span>{% endif %}
        </button>
      </li>
    {% endfor %}
    </ul>
  </aside>

  <div class="viewer" id="viewer">
  {% for doc in report.documents %}
    <div class="doc" data-doc="{{ loop.index0 }}" hidden>
      {# The page is the subject. What kind of file it is, how long it took and
         which signals rated poor are all answers to questions asked on the
         signals tab, so they are asked there. #}
      <div class="docbar">
        <h3>{{ doc.relative_path }}</h3>
        <div class="subtabs" role="tablist">
          <button type="button" data-view="pages" aria-selected="true">Pages</button>
          <button type="button" data-view="signals" aria-selected="false">Signals</button>
        </div>
      </div>

      <div data-view="pages">
        {# The workspace is the same shape for every document, including one
           nobody could open: same bar, same two frames, and the reason said
           inside them rather than in place of them. #}
        {% set rows = page_rows(doc) %}
        <div class="pagebar">
          <div class="pnav">
            <button type="button" class="pstep" data-step="-1" aria-label="Previous page"
                    {% if not rows %}disabled{% endif %}>&lsaquo;</button>
            <span class="pmid">
              <input type="number" class="pjump" min="{{ rows[0].number if rows else 0 }}"
                     max="{{ rows[-1].number if rows else 0 }}"
                     value="{{ rows[0].number if rows else 0 }}"
                     aria-label="Go to page number" {% if not rows %}disabled{% endif %}>
              <span class="pof">/ {{ rows[-1].number if rows else 0 }}</span>
            </span>
            <button type="button" class="pstep" data-step="1" aria-label="Next page"
                    {% if not rows %}disabled{% endif %}>&rsaquo;</button>
          </div>
          <span class="pmiss" hidden>no page with that number</span>
          {% if rows | selectattr("readers_differ") | first is defined %}
          <button type="button" class="pdiff"><span class="dot"></span>next page the readers
            read differently</button>
          {% endif %}
        </div>

        <div class="pageview">
        {% if not rows %}
          <div class="spread" data-page="0">
            <div class="side">
              <div class="lbl">page</div>
              <div class="body"><p class="note">No page of this document could be read.
                {% if doc.load_warnings %}{{ doc.load_warnings[0] }}{% endif %}</p></div>
              <div class="pcap"></div>
            </div>
            <div class="side">
              <div class="lbl">content</div>
              <div class="body"><p class="note">Nothing was extracted, so there is nothing
                to show here. The Signals tab says what could still be measured.</p></div>
              <div class="pcap"></div>
            </div>
          </div>
        {% endif %}
        {% for row in rows %}
          <div class="spread" data-page="{{ row.number }}"
               {% if row.readers_differ %}data-differs="1"{% endif %} hidden>
            <div class="side">
              <div class="lbl">
                {% if row.image_data_uri %}
                <span class="swap" role="group">
                  <button type="button" data-face="img" aria-selected="true">page</button>
                  <button type="button" data-face="svg" aria-selected="false">layout</button>
                </span>
                {% else %}layout{% endif %}
              </div>
              {% if row.image_data_uri %}
                {# The size is declared so the frame is the right height before the
                   image decodes; without it the panel beside it jumps on arrival. #}
                <div class="face" data-face="img"><div class="body">
                  <img class="pg" src="{{ row.image_data_uri }}" alt="Page {{ row.number }}"
                       {% if row.image_width_px %}width="{{ row.image_width_px }}"
                       height="{{ row.image_height_px }}"{% endif %}
                       loading="lazy"></div></div>
              {% endif %}
              {% if row.preview %}
                <div class="face" data-face="svg" {% if row.image_data_uri %}hidden{% endif %}>
                  <div class="body">{{ page_preview_svg(row.preview) | safe }}</div>
                </div>
              {% else %}
                <div class="body"><p class="note">This page could not be read.</p></div>
              {% endif %}
              <div class="pcap">
                <span class="flags">
                  {%- for level, label in row.flags %}<span class="flag {{ level }}">{{ label }}</span>{% if not loop.last %} · {% endif %}{% endfor -%}
                </span>
                {# Filled in while the reader points at a mark on the layout.
                   The browser's own tooltip says the same thing, after its own
                   delay; this says it at once and without covering the page. #}

              </div>
            </div>

            <div class="side">
              {# One pane per reader that was asked to read this page, so what
                 each made of it can be put side by side. Comparing a page with
                 no text layer against its own OCR output would be comparing a
                 thing to itself; --ocr-compare is what makes that one real,
                 and --compare-extractor or --compare-ocr-engine the rest. #}
              {% set compare = row.source == "native" and row.ocr_text %}
              {% set panes = [] %}
              {# When several readers are being compared, the first pane is named
                 after the one whose reading the report was built from, so the
                 switch reads as a list of readers rather than one odd one out. #}
              {%- set kept_label = (report.run.extractor if row.readings and row.source != "ocr"
                                    else ("what OCR read" if row.source == "ocr" else "text layer")) -%}
              {%- if row.text or row.ocr_text -%}
                {%- set _ = panes.append(("text", kept_label, row.text or row.ocr_text)) -%}
              {%- endif -%}
              {%- if compare -%}{%- set _ = panes.append(("ocr", "what OCR sees", row.ocr_text)) -%}{%- endif -%}
              {#- Each other reader's pane carries its differences from the kept
                  reading in place. Two plain panes to flip between would leave
                  someone to find the difference by reading both. -#}
              {%- for d in row.diffs -%}
                {%- set _ = panes.append(("read-" ~ loop.index0, d.reader, d)) -%}
              {%- endfor -%}
              <div class="lbl">
                {% if panes | length > 1 %}
                <span class="swap" role="group">
                  {% for key, label, _text in panes %}
                  <button type="button" data-face="{{ key }}"
                          aria-selected="{{ "true" if loop.first else "false" }}">{{ label }}</button>
                  {% endfor %}
                </span>
                {% elif panes %}{{ panes[0][1] }} from this page
                {% else %}content{% endif %}
              </div>
              {% if panes %}
                {% for key, label, body in panes %}
                <div class="face" data-face="{{ key }}" {% if not loop.first %}hidden{% endif %}>
                {% if body is string %}
                  <div class="body"><pre>{{ body }}</pre></div>
                  <p class="pcap">{{ "{:,}".format(body | length) }} characters, {{ label }}
                    {%- if loop.first and row.truncated %}, truncated for the report{% endif %}</p>
                {% else %}
                  <div class="body"><pre class="dif">{% for seg in body.segments -%}
{%- if seg.kind == "same" %}{{ seg.text }}{% else %}<mark
                    class="{{ seg.kind }}">{{ seg.text }}</mark>{% endif %}
{%- endfor %}</pre></div>
                  <p class="pcap">
                    {% if body.differs %}<mark class="added">only {{ label }}</mark>
                      <mark class="missing">only {{ kept_label }}</mark>
                      · {{ body.added_words }} added, {{ body.missing_words }} missing ·
                      {{ "{:.0f}%".format(body.similarity * 100) }} the same
                    {% else %}the same words as {{ kept_label }}, differently spaced{% endif %}
                    {%- if body.truncated %} · compared up to the first few thousand words
                    {%- endif %}</p>
                {% endif %}
                </div>
                {% endfor %}
              {% elif row.preview and row.preview.unreadable %}
                <div class="body"><p class="note">Nothing was read from this page. It carries no
                text layer, and {% if report.run.ocr_requested %}OCR found nothing on it
                {%- else %}OCR was not run — pass <code>--ocr</code>{% endif %}.</p></div>
              {% else %}
                <div class="body"><p class="note">This run was asked not to keep the text
                (<code>--no-extracted-text</code>), so there is nothing to show beside the
                page.</p></div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
        </div>

        <div class="key">
          <span><i class="sw" style="background:var(--pv-text);border-color:var(--pv-text)"></i> text</span>
          <span><i class="sw" style="background:var(--pv-image);border-color:var(--pv-image)"></i> image</span>
          <span><i class="sw" style="background:transparent;border-color:var(--poor)"></i> sensitive, high</span>
          <span><i class="sw" style="background:transparent;border-color:var(--fair)"></i> sensitive, other</span>
        </div>
        {% set imaged = rows | selectattr("image_data_uri") | list | length %}
        {% if report.run.page_images_used and imaged and imaged < rows | length %}
          <p class="note">{{ imaged }} of {{ rows | length }} pages were rendered as pictures;
          the rest are shown as layout. Only so many pages of one document are rasterised, so
          that a long scan cannot exhaust memory or make the report too large to send.</p>
        {% endif %}
      </div>

      <div data-view="signals" hidden>
        {% if doc.extractions | length > 1 %}
        <h4 class="sec">How it was read
          <span class="tag">{{ doc.disagreement or "they agree" }}</span></h4>
        <div class="scroll"><table>
          <thead><tr><th>Extractor</th><th class="n">Characters</th><th class="n">Coverage</th>
            <th class="n">Time</th><th class="n" title="How closely this reading matches the kept
              one, compared in order. Two readings can hold the same characters in a different
              order and this is what says so.">Matches kept</th><th>Reads</th></tr></thead>
          <tbody>
          {% for r in doc.extractions %}
            <tr{% if loop.first %} class="d-head"{% endif %}>
              <td>{{ r.extractor }}{% if loop.first %} <span class="flag">kept</span>{% endif %}</td>
              <td class="n">{{ "{:,}".format(r.characters) }}</td>
              <td class="n">{% if r.mean_coverage_pct is none %}<span class="why"
                title="This reader returns text without geometry, so there is nothing to
                  measure coverage from.">not measured</span>{% else %}{{ r.mean_coverage_pct }}%{% endif %}</td>
              <td class="n">{{ duration(r.seconds) }}</td>
              <td class="n">{% if loop.first %}—{% else %}{{ "{:.0f}%".format(r.similarity * 100) }}{% endif %}</td>
              <td class="why">{{ r.granularity }} boxes{% if r.reads_tables %}, table structure{% endif %}</td>
            </tr>
          {% endfor %}
          </tbody>
        </table></div>
        <p class="note">Only the first was used. The others read the same pages so the two
        can be compared here and now, on one machine, rather than across two runs that would
        differ for reasons of their own.</p>
        {% endif %}
        {% if doc.load_warnings %}
          <div class="notice"><strong>Reading this document was incomplete.</strong>
            <ul>{% for w in doc.load_warnings %}<li>{{ w }}</li>{% endfor %}</ul></div>
        {% endif %}
        <p class="doc-meta">{{ doc.format }} · {{ plural(doc.page_count, "page") }}{% if not doc.page_count_known %}, not fixed{% endif %}{% if doc.readiness and doc.readiness.score %} ·
          <span class="{{ 'attn' if score_band(doc.readiness.score.value) == 'poor' else '' }}">{{ doc.readiness.score.label }}, {{ doc.readiness.score.value }}/100</span>{% endif %}{% if doc.timing %} ·
          {{ duration(doc.timing.total_seconds) }} to read and analyse{% endif %}</p>
        {% set concerns = doc.readiness.signals | selectattr("rating", "equalto", "poor") | list if doc.readiness else [] %}
        {% if concerns or (doc.sensitive and doc.sensitive.unreadable_pages) %}
        <p class="concerns">
          {%- for s in concerns %}<span title="{{ s.why }}">{{ s.name | lower }} — {{ s.display }}</span>{% if not loop.last %} · {% endif %}{% endfor -%}
          {%- if doc.sensitive and doc.sensitive.unreadable_pages %}{% if concerns %} · {% endif %}<span>{{ plural(doc.sensitive.unreadable_pages | length, "page") }} not read</span>{% endif -%}
        </p>
        {% endif %}
        {% if doc.sensitive and doc.sensitive.unreadable_pages %}
          <p class="note">Page {{ doc.sensitive.unreadable_pages | join(", ") }} carried no readable
          text and {{ "was" if doc.sensitive.unreadable_pages | length == 1 else "were" }} not
          searched. Nothing was found there because nothing looked.</p>
        {% endif %}
        {% if doc.readiness %}
        <div class="scroll"><table>
          <thead><tr><th>Signal</th><th>Measured</th><th>Rating</th>
            {% if report.signal_weights %}<th class="n">Weight</th>{% endif %}<th>Why it matters</th></tr></thead>
          <tbody>
          {% for s in doc.readiness.signals %}
            <tr><td>{{ s.name }}</td>
              <td>{{ s.display }}{% if s.reason %}<div class="why">{{ s.reason }}</div>{% endif %}</td>
              <td>{% if s.rating %}<span class="r r-{{ s.rating }}">{{ s.rating }}</span>{% else %}<span class="r r-na">{{ s.status.replace("_", " ") }}</span>{% endif %}</td>
              {% if report.signal_weights %}<td class="n">{{ "%.2f"|format(s.weight) }}</td>{% endif %}
              <td class="why">{{ s.why }}</td></tr>
          {% endfor %}
          </tbody>
        </table></div>
        {% set skipped = doc.readiness.signals | rejectattr("rating") | list %}
        {% if skipped %}
        <details class="more">
          <summary>{{ plural(skipped | length, "signal") }} not measured for this document</summary>
          <div class="scroll"><table>
            <thead><tr><th>Signal</th><th>Why not</th></tr></thead>
            <tbody>{% for sg in skipped %}
              <tr><td>{{ sg.name }}</td><td class="why">{{ sg.reason or sg.status }}</td></tr>
            {% endfor %}</tbody>
          </table></div>
        </details>
        {% endif %}
        {% endif %}
        {% if doc.cost %}
        <div class="scroll"><table data-paginate="15">
          <thead><tr><th class="n">Page</th><th>Size</th><th class="n">Scan DPI</th><th>Text</th>
            <th class="n">Text coverage</th></tr></thead>
          <tbody>{% for pg in doc.cost.pages %}
            <tr><td class="n">{{ pg.number }}</td><td>{{ pg.size_label }}</td>
              <td class="n">{{ pg.dpi if pg.dpi else "—" }}</td><td>{{ pg.text_source }}</td>
              <td class="n">{{ "%.1f"|format(pg.text_coverage_pct) }}%</td></tr>
          {% endfor %}</tbody>
        </table></div>
        {% endif %}
        <p class="note">SHA-256 <code>{{ doc.sha256 }}</code></p>
      </div>
    </div>
  {% else %}
    <p class="note">No documents were audited.</p>
  {% endfor %}
  </div>
</div>
</section>

</main>

<footer>
  <div class="foot-main">
    <div>
      {{ logo_svg | safe }}
      <p class="foot-claim">No document content left this machine. Outbound network access
      was blocked for the whole run.</p>
    </div>
    <dl class="foot-meta">
      <dt>Audited</dt><dd>{{ report.run.target }}</dd>
      <dt>Finished</dt><dd>{{ report.run.finished_at }} in {{ "%.1f"|format(report.run.duration_seconds) }}s</dd>
      <dt>Documents</dt><dd>{{ agg.documents_audited }} across {{ agg.pages_total }} page{{ "" if agg.pages_total == 1 else "s" }}{% if agg.documents_skipped %}, {{ agg.documents_skipped }} skipped{% endif %}</dd>
      <dt>Read by</dt><dd>text layer{% if report.run.ocr_available and report.run.ocr_requested %}, local OCR{% endif %}{% if report.run.ner_available %}, local name detection{% endif %}</dd>
      <dt>Priced against</dt><dd>{{ plural(comparisons | length, "model") }}</dd>
      <dt>Took</dt><dd>{{ duration(agg.total_seconds) }} of work,
        {{ duration(agg.seconds_per_page) }} a page{% if agg.ocr_pages %},
        {{ agg.ocr_pages_per_second }} pages a second through OCR{% endif %}</dd>
      <dt>Options</dt><dd class="opts">{{ run_options }}</dd>
    </dl>
  </div>
  <div class="foot-rule">
    complydoc {{ report.run.tool_version }} · report schema v{{ report.run.schema_version }} ·
    config {{ report.run.config_digest }} · Python {{ report.run.python_version }} ·
    network guard {{ report.run.offline_guard }}
  </div>
</footer>

<script>
/* Progressive enhancement only: with scripting off, every document and every
   table row is already on the page. This adds a filter and pagination for runs
   large enough that scrolling stops working. */
(function () {
  "use strict";


  function providerFilter() {
    var bar = document.getElementById("providers");
    if (!bar) return;
    var buttons = Array.prototype.slice.call(bar.querySelectorAll("button"));
    var charts = Array.prototype.slice.call(document.querySelectorAll("svg.chart"));
    var still = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    var DURATION = still ? 0 : 260;

    // The viewBox is an attribute, so CSS cannot transition it. Without tweening
    // it the chart snapped to its new height while the bars were still sliding,
    // which read as a jump rather than a filter.
    function resize(svg, to) {
      var box = svg.getAttribute("viewBox").split(" ");
      var from = parseFloat(box[3]);
      var axis = svg.querySelector("line.axis");
      if (svg._tween) cancelAnimationFrame(svg._tween);

      function paint(height) {
        svg.setAttribute("viewBox", box[0] + " " + box[1] + " " + box[2] + " " + height);
        svg.setAttribute("height", height);
        if (axis) axis.setAttribute("y2", Math.max(0, height - 16));
      }
      if (!DURATION || from === to) {
        paint(to);
        return;
      }
      var started = performance.now();
      function frame(now) {
        var t = Math.min(1, (now - started) / DURATION);
        var eased = t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2;
        paint(from + (to - from) * eased);
        if (t < 1) svg._tween = requestAnimationFrame(frame);
      }
      svg._tween = requestAnimationFrame(frame);
    }

    function apply(provider) {
      buttons.forEach(function (b) {
        b.setAttribute("aria-pressed", String(b.getAttribute("data-provider") === provider));
      });
      charts.forEach(function (svg) {
        var step = parseFloat(svg.getAttribute("data-step"));
        var top = parseFloat(svg.getAttribute("data-top"));
        var groups = Array.prototype.slice.call(svg.querySelectorAll("g.grp"));
        var shown = 0;
        groups.forEach(function (g) {
          var keep = !provider || g.getAttribute("data-provider") === provider;
          if (keep) {
            // Slide into the slot the hidden rows vacated rather than reflowing.
            g.setAttribute("transform", "translate(0," + (top + shown * step) + ")");
            g.classList.remove("out");
            shown++;
          } else {
            g.classList.add("out");
          }
        });
        resize(svg, top + Math.max(shown, 1) * step);
      });
    }
    buttons.forEach(function (b) {
      b.addEventListener("click", function () { apply(b.getAttribute("data-provider")); });
    });
  }

  function explorer() {
    var root = document.getElementById("explorer");
    if (!root) return;
    var items = Array.prototype.slice.call(root.querySelectorAll("#filelist > li"));
    var docs = Array.prototype.slice.call(root.querySelectorAll(".viewer > .doc"));
    var input = document.getElementById("docfilter");
    var count = document.getElementById("doccount");
    if (!items.length) return;

    function select(index) {
      docs.forEach(function (d) { d.hidden = d.getAttribute("data-doc") !== index; });
      root.dispatchEvent(new Event("aligned"));
      items.forEach(function (li) {
        var button = li.querySelector("button");
        if (button.getAttribute("data-doc") === index) button.setAttribute("aria-current", "true");
        else button.removeAttribute("aria-current");
      });
    }

    items.forEach(function (li) {
      li.querySelector("button").addEventListener("click", function () {
        select(li.querySelector("button").getAttribute("data-doc"));
      });
    });

    // Sit the file list at the height of the panels rather than the height of
    // the column, which also carries the filename and the page bar above them.
    var aside = root.querySelector(".files");
    function alignFiles() {
      if (!aside) return;
      if (window.innerWidth <= 860) { aside.style.marginTop = ""; return; }

      var doc = root.querySelector(".viewer > .doc:not([hidden])");
      // Centred on the panels, and only on the panels. Note the offsetParent
      // check: a panel is hidden along with the whole Pages view when the
      // signals tab is showing, and `:not([hidden])` still matches it because
      // the attribute is on its container. Measuring that ghost is what moved
      // the list about depending on which tab you were on.
      var panels = null;
      var candidates = doc ? doc.querySelectorAll(".spread:not([hidden])") : [];
      for (var i = 0; i < candidates.length; i++) {
        if (candidates[i].offsetParent !== null) { panels = candidates[i]; break; }
      }
      if (!panels) { aside.style.marginTop = ""; return; }

      aside.style.marginTop = "0px";
      var top = root.getBoundingClientRect().top;
      var box = panels.getBoundingClientRect();
      var offset = box.top + box.height / 2 - top - aside.getBoundingClientRect().height / 2;
      aside.style.marginTop = Math.max(0, Math.round(offset)) + "px";
    }

    // Anything that changes the height of the workspace has to re-run this.
    // Watching the element covers the cases nobody thought to fire an event for:
    // a page image finishing its decode, a tab, a font, a window.
    root.addEventListener("aligned", alignFiles);
    window.addEventListener("resize", alignFiles);
    // The first paint happens before the page images have their size, and a
    // resize settles a frame after the event. Both would otherwise leave the
    // list sitting slightly off until the reader touched something.
    window.addEventListener("load", alignFiles);
    if (window.requestAnimationFrame) {
      window.requestAnimationFrame(function () { alignFiles(); });
    }
    if (window.ResizeObserver) {
      var watcher = new ResizeObserver(function () { alignFiles(); });
      var viewer = root.querySelector(".viewer");
      if (viewer) watcher.observe(viewer);
    } else {
      Array.prototype.forEach.call(root.querySelectorAll(".viewer img"), function (image) {
        image.addEventListener("load", alignFiles);
      });
    }

    function firstVisible() {
      var li = items.filter(function (x) { return !x.hidden; })[0];
      return li ? li.querySelector("button").getAttribute("data-doc") : null;
    }

    function apply() {
      // Matches the file name, format, text source and the signals actually rated
      // poor — not the explanatory prose, which is identical in every document and
      // made a search for "rotated" return the whole folder.
      var q = input ? input.value.trim().toLowerCase() : "";
      var shown = 0;
      items.forEach(function (li) {
        var hit = !q || (li.getAttribute("data-search") || "").indexOf(q) !== -1;
        li.hidden = !hit;
        if (hit) shown++;
      });
      if (count) {
        count.textContent = q
          ? shown + " of " + items.length + " files"
          : items.length + (items.length === 1 ? " file" : " files");
      }
      var current = docs.filter(function (d) { return !d.hidden; })[0];
      var visible = firstVisible();
      if (visible && (!current || items.filter(function (li) {
        return !li.hidden && li.querySelector("button").getAttribute("data-doc") ===
          current.getAttribute("data-doc");
      }).length === 0)) {
        select(visible);
      }
    }

    if (input) input.addEventListener("input", apply);
    apply();
    select(items[0].querySelector("button").getAttribute("data-doc"));

    docs.forEach(function (doc) {
      var buttons = Array.prototype.slice.call(doc.querySelectorAll(".subtabs button"));
      var views = Array.prototype.slice.call(doc.querySelectorAll("[data-view]"))
        .filter(function (v) { return v.tagName !== "BUTTON"; });
      buttons.forEach(function (button) {
        button.addEventListener("click", function () {
          var want = button.getAttribute("data-view");
          buttons.forEach(function (b) {
            b.setAttribute("aria-selected", String(b === button));
          });
          views.forEach(function (v) { v.hidden = v.getAttribute("data-view") !== want; });
          root.dispatchEvent(new Event("aligned"));
        });
      });
      pageviewer(doc);
    });
    alignFiles();
  }

  // One page at a time, the page beside the text read off it. Every page of the
  // document is reachable: the arrows step, and the number box jumps straight to
  // a page, which is the only practical way through a long scan.
  function pageviewer(doc) {
    var bar = doc.querySelector(".pagebar");
    var spreads = Array.prototype.slice.call(doc.querySelectorAll(".pageview > .spread"))
      .filter(function (s) { return s.getAttribute("data-page") !== "0"; });
    // A document with no readable page still draws the workspace, with the
    // reason inside it; there is just nothing to step through.
    if (!bar || !spreads.length) return;

    var numbers = spreads.map(function (s) { return Number(s.getAttribute("data-page")); });
    var jump = bar.querySelector(".pjump");
    var missing = bar.querySelector(".pmiss");
    var steps = Array.prototype.slice.call(bar.querySelectorAll(".pstep"));
    var at = 0;

    function show(index) {
      at = Math.max(0, Math.min(spreads.length - 1, index));
      spreads.forEach(function (s, i) { s.hidden = i !== at; });
      steps.forEach(function (b) {
        var step = Number(b.getAttribute("data-step"));
        b.disabled = step < 0 ? at === 0 : at === spreads.length - 1;
      });
      if (jump && document.activeElement !== jump) jump.value = String(numbers[at]);
      if (missing) missing.hidden = true;
      var explorer = doc.closest("#explorer");
      if (explorer) explorer.dispatchEvent(new Event("aligned"));
    }

    steps.forEach(function (button) {
      button.addEventListener("click", function () {
        show(at + Number(button.getAttribute("data-step")));
      });
    });

    if (jump) {
      jump.addEventListener("input", function () {
        var wanted = Number(jump.value);
        if (jump.value === "") { if (missing) missing.hidden = true; return; }
        var index = numbers.indexOf(wanted);
        // A page number the document does not have is said so rather than
        // silently snapping to the nearest one, which would be a lie about
        // which page you are looking at.
        if (index === -1) { if (missing) missing.hidden = false; return; }
        show(index);
      });
      jump.addEventListener("blur", function () { show(at); });
    }

    // The pages where the readers parted company are the only ones worth
    // looking at when comparing, and on a long document they are a handful
    // among hundreds. Wraps around, so the button keeps working at the end.
    var differing = bar.querySelector(".pdiff");
    if (differing) {
      var marked = [];
      spreads.forEach(function (s, i) {
        if (s.getAttribute("data-differs") === "1") marked.push(i);
      });
      if (!marked.length) {
        differing.hidden = true;
      } else {
        differing.addEventListener("click", function () {
          var next = marked.find(function (i) { return i > at; });
          show(next === undefined ? marked[0] : next);
        });
      }
    }

    doc.addEventListener("keydown", function (event) {
      if (event.target === jump || event.metaKey || event.ctrlKey || event.altKey) return;
      if (event.key === "ArrowLeft") { show(at - 1); event.preventDefault(); }
      if (event.key === "ArrowRight") { show(at + 1); event.preventDefault(); }
    });

    // Pointing at a mark on the layout says what it is, beside the mark. The
    // <title> in the markup says the same thing for a reader without script and
    // for a screen reader; this is only quicker and does not wait for the
    // browser's own tooltip delay.
    Array.prototype.slice.call(doc.querySelectorAll(".pv-mark")).forEach(function (mark) {
      var face = mark.closest(".face");
      var tipText = mark.getAttribute("data-tip");
      if (!face || !tipText) return;

      function show() {
        var tip = face.querySelector(".pv-tip");
        if (!tip) {
          tip = document.createElement("div");
          tip.className = "pv-tip";
          face.appendChild(tip);
        }
        var lines = tipText.split("\n");
        tip.textContent = "";
        var head = document.createElement("b");
        head.textContent = lines[0];
        tip.appendChild(head);
        // What was found, masked as the findings table masks it. A rectangle
        // and a category leaves you hunting for which one it was.
        var found = mark.getAttribute("data-value");
        if (found) {
          var shown = document.createElement("span");
          shown.className = "found";
          shown.textContent = found;
          tip.appendChild(shown);
        }
        if (lines.length > 1) {
          var rest = document.createElement("span");
          rest.className = "why";
          rest.textContent = lines.slice(1).join(" ");
          tip.appendChild(rest);
        }
        tip.hidden = false;

        // Placed above the mark where there is room, below it where there is
        // not, and kept inside the panel either way so it is never clipped.
        var box = mark.getBoundingClientRect();
        var frame = face.getBoundingClientRect();
        var gap = 6;
        var left = box.left - frame.left;
        var top = box.top - frame.top - tip.offsetHeight - gap;
        if (top < 0) top = box.bottom - frame.top + gap;
        var overflow = left + tip.offsetWidth - frame.width;
        if (overflow > 0) left -= overflow;
        tip.style.left = Math.max(0, left) + "px";
        tip.style.top = Math.max(0, top) + "px";
      }
      function hide() {
        var tip = face.querySelector(".pv-tip");
        if (tip) tip.hidden = true;
      }
      mark.addEventListener("pointerenter", show);
      mark.addEventListener("pointerleave", hide);
      mark.addEventListener("focus", show);
      mark.addEventListener("blur", hide);
      mark.setAttribute("tabindex", "0");
    });

    // The page/layout and text/OCR switches, scoped to the side they sit in.
    Array.prototype.slice.call(doc.querySelectorAll(".spread .swap")).forEach(function (swap) {
      var side = swap.closest(".side");
      var options = Array.prototype.slice.call(swap.querySelectorAll("button"));
      var faces = Array.prototype.slice.call(side.querySelectorAll(".face"));
      options.forEach(function (option) {
        option.addEventListener("click", function () {
          var want = option.getAttribute("data-face");
          options.forEach(function (o) { o.setAttribute("aria-selected", String(o === option)); });
          faces.forEach(function (f) { f.hidden = f.getAttribute("data-face") !== want; });
          var explorer = doc.closest("#explorer");
          if (explorer) explorer.dispatchEvent(new Event("aligned"));
        });
      });
    });

    show(0);
  }

  function theme() {
    var button = document.getElementById("theme");
    if (!button) return;
    button.hidden = false;
    var root = document.documentElement;

    function current() {
      var set = root.getAttribute("data-theme");
      if (set) return set;
      return window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
    }
    function paint() {
      var dark = current() === "dark";
      button.textContent = dark ? "Light" : "Dark";
      button.setAttribute("aria-pressed", String(dark));
    }
    button.addEventListener("click", function () {
      root.setAttribute("data-theme", current() === "dark" ? "light" : "dark");
      paint();
    });
    paint();
  }

  function paginate(table) {
    var size = parseInt(table.getAttribute("data-paginate"), 10);
    var body = table.tBodies[0];
    if (!body || !size) return;
    if (body.rows.length <= size) return;

    var page = 0;
    var pages = Math.ceil(body.rows.length / size);

    var bar = document.createElement("div");
    bar.className = "pager";
    var prev = document.createElement("button");
    prev.type = "button";
    prev.textContent = "Previous";
    var next = document.createElement("button");
    next.type = "button";
    next.textContent = "Next";
    var label = document.createElement("span");
    bar.appendChild(prev);
    bar.appendChild(next);
    bar.appendChild(label);
    var host = table.parentNode;
    host.parentNode.insertBefore(bar, host.nextSibling);

    function draw() {
      // Re-read the rows every time: sorting reorders them in the DOM, so a
      // list captured once would page through yesterday's order.
      var rows = Array.prototype.slice.call(body.rows);
      var first = page * size;
      var last = Math.min(first + size, rows.length);
      rows.forEach(function (row, i) { row.hidden = i < first || i >= last; });
      label.textContent = "Showing " + (first + 1) + "\u2013" + last + " of " + rows.length;
      prev.disabled = page === 0;
      next.disabled = page >= pages - 1;
    }
    prev.addEventListener("click", function () { if (page > 0) { page--; draw(); } });
    next.addEventListener("click", function () { if (page < pages - 1) { page++; draw(); } });
    table.addEventListener("sorted", function () { page = 0; draw(); });
    draw();
  }

  // Click a column to reorder. Numeric columns sort on data-value when a cell
  // carries one, which is how severity sorts high > medium > low rather than
  // alphabetically.
  function sortable(table) {
    var body = table.tBodies[0];
    if (!body) return;
    var headers = Array.prototype.slice.call(table.querySelectorAll("th[data-sort]"));

    function value(row, index, kind) {
      var cell = row.cells[index];
      if (!cell) return kind === "num" ? 0 : "";
      var explicit = cell.getAttribute("data-value");
      var text = explicit !== null ? explicit : cell.textContent.trim();
      return kind === "num" ? parseFloat(text.replace(/[^0-9.\-]/g, "")) || 0 : text.toLowerCase();
    }

    headers.forEach(function (header) {
      var index = Array.prototype.indexOf.call(header.parentNode.cells, header);
      var kind = header.getAttribute("data-sort");
      header.tabIndex = 0;
      header.setAttribute("role", "button");
      if (header.getAttribute("data-sort-default")) {
        header.setAttribute("aria-sort", "descending");
      }

      function apply() {
        var descending = header.getAttribute("aria-sort") !== "descending";
        headers.forEach(function (h) { h.removeAttribute("aria-sort"); });
        header.setAttribute("aria-sort", descending ? "descending" : "ascending");
        Array.prototype.slice.call(body.rows)
          .sort(function (a, b) {
            var left = value(a, index, kind);
            var right = value(b, index, kind);
            if (left === right) return 0;
            return (left < right ? -1 : 1) * (descending ? -1 : 1);
          })
          .forEach(function (row) { body.appendChild(row); });
        table.dispatchEvent(new Event("sorted"));
      }

      header.addEventListener("click", apply);
      header.addEventListener("keydown", function (event) {
        if (event.key === "Enter" || event.key === " ") { event.preventDefault(); apply(); }
      });
    });
  }


  function tabs() {
    var nav = document.getElementById("tabs");
    if (!nav) return;
    var links = Array.prototype.slice.call(nav.querySelectorAll("a"));
    var pages = Array.prototype.slice.call(document.querySelectorAll("section[data-page]"));

    function show(id) {
      var known = pages.some(function (p) { return p.id === id; });
      if (!known) id = pages[0].id;
      pages.forEach(function (p) { p.hidden = p.id !== id; });
      links.forEach(function (a) {
        if (a.getAttribute("data-tab") === id) a.setAttribute("aria-current", "page");
        else a.removeAttribute("aria-current");
      });
      window.scrollTo(0, 0);
      // The documents page cannot be measured while it is hidden, so anything
      // laid out against its contents is told the moment it is shown.
      var explorer = document.getElementById("explorer");
      if (explorer) explorer.dispatchEvent(new Event("aligned"));
    }
    // The click is the mechanism; the hash is a convenience on top of it. Some
    // viewers — a data: URL, a sandboxed mail preview — never report a hash, and
    // relying on it there would leave every tab dead but the first.
    links.forEach(function (a) {
      a.addEventListener("click", function (event) {
        event.preventDefault();
        var id = a.getAttribute("data-tab");
        show(id);
        try {
          history.replaceState(null, "", "#" + id);
        } catch (err) {
          /* file:// and data: URLs may refuse; the view has already switched. */
        }
      });
    });
    window.addEventListener("hashchange", function () {
      show(location.hash.replace("#", ""));
    });
    show(location.hash.replace("#", "") || pages[0].id);
  }

  function paginateList(host) {
    var size = parseInt(host.getAttribute("data-paginate-list"), 10);
    var items = Array.prototype.slice.call(host.children);
    if (!size || items.length <= size) return;
    var page = 0, count = Math.ceil(items.length / size);
    var bar = document.createElement("div");
    bar.className = "pager";
    var prev = document.createElement("button"); prev.type = "button"; prev.textContent = "Previous";
    var next = document.createElement("button"); next.type = "button"; next.textContent = "Next";
    var label = document.createElement("span");
    bar.appendChild(prev); bar.appendChild(next); bar.appendChild(label);
    host.parentNode.insertBefore(bar, host.nextSibling);
    function draw() {
      var first = page * size, last = Math.min(first + size, items.length);
      items.forEach(function (el, i) { el.hidden = i < first || i >= last; });
      label.textContent = "Showing " + (first + 1) + "\u2013" + last + " of " + items.length;
      prev.disabled = page === 0; next.disabled = page >= count - 1;
    }
    prev.addEventListener("click", function () { if (page > 0) { page--; draw(); } });
    next.addEventListener("click", function () { if (page < count - 1) { page++; draw(); } });
    draw();
  }

  tabs();
  Array.prototype.forEach.call(
    document.querySelectorAll("[data-paginate-list]"), paginateList
  );
  explorer();
  providerFilter();
  theme();
  Array.prototype.forEach.call(document.querySelectorAll("table[data-sortable]"), sortable);
  Array.prototype.forEach.call(
    document.querySelectorAll("table[data-paginate]"), paginate
  );
})();
</script>
</body>
</html>
